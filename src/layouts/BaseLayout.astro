---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
import {
  getLangFromUrl,
  switchLanguagePath,
  type Lang,
} from '../i18n';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/utilities.css';

interface Props {
  lang?: Lang;
  alternatePath?: string;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const currentPath = Astro.url.pathname;
const alternatePath =
  Astro.props.alternatePath ?? switchLanguagePath(currentPath, otherLang);
const currentAbsoluteUrl = new URL(currentPath, siteConfig.url).href;
const alternateAbsoluteUrl = new URL(alternatePath, siteConfig.url).href;
const enUrl = lang === 'en' ? currentAbsoluteUrl : alternateAbsoluteUrl;
const esUrl = lang === 'es' ? currentAbsoluteUrl : alternateAbsoluteUrl;
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <slot name="head" />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#29333e" />

    <!-- Google Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-E3QNQLY611"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('config', 'G-E3QNQLY611');
    </script>

    <ClientRouter />

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <Navigation lang={lang} alternatePath={alternatePath} />
    </header>

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
