---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props as Props;

const copy = {
  es: {
    kicker: 'Madurez del dato',
    title: 'Tres etapas, tres formas distintas de generar valor',
    intro: 'Selecciona cada etapa para ver cómo cambia el foco técnico y organizativo.',
    stageLabel: 'Etapa',
    focusLabel: 'Foco principal',
    traitsLabel: 'Qué empieza a importar',
    stages: [
      {
        id: 'starting',
        number: '01',
        title: 'Starting with data',
        subtitle: 'Hacer que funcione',
        description:
          'El equipo intenta demostrar valor con rapidez. Hay muchas necesidades, pocos recursos y todavía no existe una plataforma de datos consolidada.',
        focus: 'Velocidad y utilidad inmediata',
        traits: ['Equipos pequeños', 'Objetivos todavía difusos', 'Soluciones rápidas', 'Mucho conocimiento implícito'],
        icon: 'spark',
      },
      {
        id: 'scaling',
        number: '02',
        title: 'Scaling with data',
        subtitle: 'Profesionalizar y escalar',
        description:
          'La organización ya ha comprobado el valor del dato. El reto pasa a ser construir una base técnica más consistente, automatizada y mantenible.',
        focus: 'Calidad, automatización y escalabilidad',
        traits: ['Pipelines orquestados', 'Modelos consistentes', 'DataOps', 'Observabilidad y calidad'],
        icon: 'pipeline',
      },
      {
        id: 'leading',
        number: '03',
        title: 'Leading with data',
        subtitle: 'El dato como producto',
        description:
          'El dato deja de ser únicamente soporte técnico y pasa a formar parte de la forma en la que la compañía opera, decide y crea nuevos productos.',
        focus: 'Decisión, confianza y ventaja competitiva',
        traits: ['Dato como producto', 'Gobierno y ownership', 'Decisiones data-driven', 'Uso transversal'],
        icon: 'product',
      },
    ],
  },
  en: {
    kicker: 'Data maturity',
    title: 'Three stages, three different ways of creating value',
    intro: 'Select each stage to see how the technical and organisational focus changes.',
    stageLabel: 'Stage',
    focusLabel: 'Main focus',
    traitsLabel: 'What starts to matter',
    stages: [
      {
        id: 'starting',
        number: '01',
        title: 'Starting with data',
        subtitle: 'Make it work',
        description:
          'The team is trying to prove value quickly. There are many needs, limited resources and no consolidated data platform yet.',
        focus: 'Speed and immediate usefulness',
        traits: ['Small teams', 'Still unclear objectives', 'Fast solutions', 'A lot of implicit knowledge'],
        icon: 'spark',
      },
      {
        id: 'scaling',
        number: '02',
        title: 'Scaling with data',
        subtitle: 'Professionalise and scale',
        description:
          'The organisation has already seen the value of data. The challenge becomes building a more consistent, automated and maintainable technical foundation.',
        focus: 'Quality, automation and scalability',
        traits: ['Orchestrated pipelines', 'Consistent models', 'DataOps', 'Observability and quality'],
        icon: 'pipeline',
      },
      {
        id: 'leading',
        number: '03',
        title: 'Leading with data',
        subtitle: 'Data as a product',
        description:
          'Data is no longer only a technical support function. It becomes part of how the company operates, makes decisions and creates new products.',
        focus: 'Decision-making, trust and competitive advantage',
        traits: ['Data as a product', 'Governance and ownership', 'Data-driven decisions', 'Cross-company usage'],
        icon: 'product',
      },
    ],
  },
}[lang];

const iconPaths = {
  spark: `
    <path d="M12 3v4"/><path d="M12 17v4"/><path d="m4.2 4.2 2.9 2.9"/><path d="m16.9 16.9 2.9 2.9"/>
    <path d="M3 12h4"/><path d="M17 12h4"/><path d="m4.2 19.8 2.9-2.9"/><path d="m16.9 7.1 2.9-2.9"/>
    <circle cx="12" cy="12" r="3.4"/>
  `,
  pipeline: `
    <rect x="2.5" y="7" width="5" height="10" rx="1.3"/><rect x="9.5" y="7" width="5" height="10" rx="1.3"/><rect x="16.5" y="7" width="5" height="10" rx="1.3"/>
    <path d="M7.5 12h2"/><path d="M14.5 12h2"/><path d="m8.7 10.8 1.2 1.2-1.2 1.2"/><path d="m15.7 10.8 1.2 1.2-1.2 1.2"/>
  `,
  product: `
    <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5"/><path d="M12 12v9"/>
    <path d="m8 5.2 8 4.5"/>
  `,
};
---

<section class="maturity-explorer" data-maturity-explorer aria-labelledby={`maturity-title-${lang}`}>
  <header class="explorer-heading">
    <span class="explorer-kicker">{copy.kicker}</span>
    <h2 id={`maturity-title-${lang}`}>{copy.title}</h2>
    <p>{copy.intro}</p>
  </header>

  <div class="maturity-map" aria-hidden="true">
    <div class="map-line"><span data-progress-line></span></div>
    {copy.stages.map((stage, index) => (
      <div class:list={['map-node', index === 0 && 'is-active']} data-map-node data-stage-index={index}>
        <span>{stage.number}</span>
      </div>
    ))}
  </div>

  <div class="stage-tabs" role="tablist" aria-label={copy.title}>
    {copy.stages.map((stage, index) => (
      <button
        type="button"
        class:list={['stage-tab', index === 0 && 'is-active']}
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`stage-panel-${lang}-${index}`}
        id={`stage-tab-${lang}-${index}`}
        tabindex={index === 0 ? 0 : -1}
        data-stage-button
        data-stage-index={index}
      >
        <span class="stage-tab-top">
          <span class="stage-number">{stage.number}</span>
          <span class="stage-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[stage.icon as keyof typeof iconPaths]} />
          </span>
        </span>
        <strong>{stage.title}</strong>
        <span>{stage.subtitle}</span>
      </button>
    ))}
  </div>

  <div class="stage-panels">
    {copy.stages.map((stage, index) => (
      <article
        id={`stage-panel-${lang}-${index}`}
        class:list={['stage-panel', index === 0 && 'is-active']}
        role="tabpanel"
        aria-labelledby={`stage-tab-${lang}-${index}`}
        hidden={index !== 0}
        data-stage-panel
        data-stage-index={index}
      >
        <div class="panel-copy">
          <span class="panel-eyebrow">{copy.stageLabel} {stage.number}</span>
          <h3>{stage.title}</h3>
          <p>{stage.description}</p>
        </div>

        <div class="panel-details">
          <div class="focus-box">
            <span>{copy.focusLabel}</span>
            <strong>{stage.focus}</strong>
          </div>

          <div class="traits-box">
            <span>{copy.traitsLabel}</span>
            <ul>
              {stage.traits.map((trait) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m5 10 3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {trait}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const initMaturityExplorer = (root: Element) => {
    if (!(root instanceof HTMLElement) || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-stage-button]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-stage-panel]')];
    const nodes = [...root.querySelectorAll<HTMLElement>('[data-map-node]')];
    const progress = root.querySelector<HTMLElement>('[data-progress-line]');

    const activate = (index: number, moveFocus = false) => {
      const safeIndex = Math.max(0, Math.min(index, buttons.length - 1));

      buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === safeIndex;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', active ? 'true' : 'false');
        button.setAttribute('tabindex', active ? '0' : '-1');
      });

      panels.forEach((panel, panelIndex) => {
        const active = panelIndex === safeIndex;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });

      nodes.forEach((node, nodeIndex) => {
        node.classList.toggle('is-active', nodeIndex <= safeIndex);
      });

      if (progress) {
        progress.style.width = `${safeIndex * 50}%`;
      }

      if (moveFocus) {
        buttons[safeIndex]?.focus();
      }
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(index));
      button.addEventListener('keydown', (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          activate((index + 1) % buttons.length, true);
        }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          activate((index - 1 + buttons.length) % buttons.length, true);
        }
        if (event.key === 'Home') {
          event.preventDefault();
          activate(0, true);
        }
        if (event.key === 'End') {
          event.preventDefault();
          activate(buttons.length - 1, true);
        }
      });
    });
  };

  const setupMaturityExplorers = () => {
    document.querySelectorAll('[data-maturity-explorer]').forEach(initMaturityExplorer);
  };

  setupMaturityExplorers();
  document.addEventListener('astro:page-load', setupMaturityExplorers);
</script>

<style>
  .maturity-explorer {
    margin: 2.25rem 0 3rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: linear-gradient(145deg, color-mix(in srgb, var(--color-bg-elevated) 88%, transparent), color-mix(in srgb, var(--color-bg-secondary) 94%, transparent));
    box-shadow: var(--shadow-md);
  }

  .explorer-heading {
    margin-bottom: 1.4rem;
  }

  .explorer-kicker,
  .panel-eyebrow,
  .focus-box > span,
  .traits-box > span {
    display: block;
    color: var(--color-text-muted);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .explorer-heading h2 {
    margin: .35rem 0 .55rem;
    font-size: clamp(1.45rem, 3.2vw, 2.15rem);
    line-height: 1.15;
    letter-spacing: -.035em;
  }

  .explorer-heading p {
    margin: 0;
    max-width: 620px;
    color: var(--color-text-secondary);
    font-size: .92rem;
    line-height: 1.65;
  }

  .maturity-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    margin: .8rem .65rem 1rem;
  }

  .map-line {
    position: absolute;
    top: 50%;
    right: 9%;
    left: 9%;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-border);
    transform: translateY(-50%);
  }

  .map-line span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
    transition: width .45s cubic-bezier(.2,.7,.2,1);
  }

  .map-node {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg-secondary);
    color: var(--color-text-muted);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-bg-secondary) 92%, transparent);
    transition: transform .25s ease, border-color .25s ease, color .25s ease, background .25s ease;
  }

  .map-node span {
    font-size: .65rem;
    font-weight: 800;
  }

  .map-node.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
    color: var(--color-text);
    transform: scale(1.08);
  }

  .stage-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
  }

  .stage-tab {
    min-width: 0;
    padding: .9rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-bg-secondary) 88%, transparent);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }

  .stage-tab:hover,
  .stage-tab:focus-visible {
    border-color: var(--color-accent);
  }

  .stage-tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .stage-tab.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 30%, transparent);
    transform: translateY(-2px);
  }

  .stage-tab-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .8rem;
  }

  .stage-number {
    color: var(--color-text-muted);
    font-size: .67rem;
    font-weight: 800;
    letter-spacing: .1em;
  }

  .stage-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
  }

  .stage-icon svg {
    width: 18px;
    height: 18px;
  }

  .stage-tab strong {
    display: block;
    margin-bottom: .25rem;
    font-size: .88rem;
    line-height: 1.35;
  }

  .stage-tab > span:last-child {
    display: block;
    color: var(--color-text-muted);
    font-size: .76rem;
    line-height: 1.4;
  }

  .stage-panels {
    margin-top: .75rem;
  }

  .stage-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(230px, .85fr);
    gap: 1rem;
    padding: 1.1rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-bg) 35%, transparent);
    animation: panelIn .28s ease both;
  }

  .stage-panel[hidden] {
    display: none;
  }

  .panel-copy h3 {
    margin: .35rem 0 .55rem;
    font-size: 1.15rem;
    letter-spacing: -.02em;
  }

  .panel-copy p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: .88rem;
    line-height: 1.7;
  }

  .panel-details {
    display: grid;
    gap: .65rem;
  }

  .focus-box,
  .traits-box {
    padding: .8rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-bg-elevated) 78%, transparent);
  }

  .focus-box strong {
    display: block;
    margin-top: .32rem;
    font-size: .84rem;
    line-height: 1.5;
  }

  .traits-box ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .45rem .6rem;
    margin: .55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .traits-box li {
    display: flex;
    align-items: flex-start;
    gap: .35rem;
    color: var(--color-text-secondary);
    font-size: .75rem;
    line-height: 1.4;
  }

  .traits-box li svg {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin-top: .08rem;
    color: var(--color-accent);
  }

  @keyframes panelIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 720px) {
    .maturity-explorer {
      padding: 1rem;
    }

    .stage-tabs {
      grid-template-columns: 1fr;
    }

    .maturity-map {
      display: none;
    }

    .stage-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 440px) {
    .traits-box ul {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-line span,
    .map-node,
    .stage-tab {
      transition: none;
    }

    .stage-panel {
      animation: none;
    }
  }
</style>
