---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props as Props;

const copy = {
  es: {
    eyebrow: 'Arquitectura de datos',
    title: 'La pieza que faltaba',
    subtitle: 'No necesitaba otra herramienta para mover datos. Necesitaba separar responsabilidades.',
    stages: [
      { number: '01', title: 'Fuentes', text: 'BBDD, APIs, ficheros y herramientas corporativas.', icon: 'source' },
      { number: '02', title: 'Airflow', text: 'Orquestación, extracción, cargas incrementales y observabilidad.', icon: 'flow' },
      { number: '03', title: 'dbt', text: 'Transformación, reglas de negocio, tests y documentación.', icon: 'dbt' },
      { number: '04', title: 'SQL Server', text: 'Almacenamiento centralizado y modelos del Data Warehouse.', icon: 'database' },
      { number: '05', title: 'Consumo', text: 'Power BI, automatizaciones y otros casos de negocio.', icon: 'chart' },
    ],
    before: 'Solo Python',
    after: 'Con dbt',
    beforeItems: [
      'Transformaciones mezcladas con la ETL',
      'Testing más artesanal',
      'Documentación separada',
      'Más código para mantener',
      'Mayor acoplamiento',
    ],
    afterItems: [
      'Modelos SQL modulares',
      'Tests declarativos',
      'Documentación integrada',
      'Versionado ordenado',
      'Separación clara de capas',
    ],
    quote: 'dbt no sustituyó a Airflow ni a SQL Server. Me permitió dar a cada pieza una responsabilidad mucho más clara.',
  },
  en: {
    eyebrow: 'Data architecture',
    title: 'The missing piece',
    subtitle: 'I did not need another tool to move data. I needed a clean separation of responsibilities.',
    stages: [
      { number: '01', title: 'Sources', text: 'Databases, APIs, files and corporate tools.', icon: 'source' },
      { number: '02', title: 'Airflow', text: 'Orchestration, extraction, incremental loads and observability.', icon: 'flow' },
      { number: '03', title: 'dbt', text: 'Transformation, business logic, tests and documentation.', icon: 'dbt' },
      { number: '04', title: 'SQL Server', text: 'Centralised storage and Data Warehouse models.', icon: 'database' },
      { number: '05', title: 'Consumption', text: 'Power BI, automations and other business use cases.', icon: 'chart' },
    ],
    before: 'Python only',
    after: 'With dbt',
    beforeItems: [
      'Transformations mixed with ETL',
      'More manual testing',
      'Separate documentation',
      'More code to maintain',
      'Higher coupling',
    ],
    afterItems: [
      'Modular SQL models',
      'Declarative tests',
      'Integrated documentation',
      'Clean version control',
      'Clear separation of layers',
    ],
    quote: 'dbt did not replace Airflow or SQL Server. It helped me give each part of the stack a much clearer responsibility.',
  }
}[lang];

const icons: Record<string, string> = {
  source: '<path d="M4 6h7l2 2h7v10H4z"/><path d="M8 12h8"/>',
  flow: '<circle cx="6" cy="12" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M8 12h4c3 0 4-2 4-4"/><path d="M12 12c3 0 4 2 4 4"/>',
  dbt: '<path d="M12 4c-4 0-7 3-7 7 0 3 2 6 5 7l-1 3 4-3c4 0 7-3 7-7s-4-7-8-7Z"/><circle cx="10" cy="11" r="1"/><circle cx="14" cy="11" r="1"/>',
  database: '<ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 2 3 3 7 3s7-1 7-3V5"/><path d="M5 11v6c0 2 3 3 7 3s7-1 7-3v-6"/>',
  chart: '<path d="M5 19V9"/><path d="M10 19V5"/><path d="M15 19v-7"/><path d="M20 19V3"/>',
};
---

<section class="dbt-journey" data-dbt-journey>
  <header class="journey-header">
    <span>{copy.eyebrow}</span>
    <h2>{copy.title}</h2>
    <p>{copy.subtitle}</p>
  </header>

  <div class="architecture-track">
    {copy.stages.map((stage, index) => (
      <>
        <article class:list={['stage', { 'stage--dbt': stage.icon === 'dbt' }]}>
          <div class="stage-top">
            <span class="number">{stage.number}</span>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[stage.icon]} />
            </span>
          </div>
          <h3>{stage.title}</h3>
          <p>{stage.text}</p>
        </article>

        {index < copy.stages.length - 1 && (
          <span class="arrow" aria-hidden="true">→</span>
        )}
      </>
    ))}
  </div>

  <div class="comparison">
    <article class="comparison-card before">
      <h3>{copy.before}</h3>
      <ul>
        {copy.beforeItems.map((item) => <li>{item}</li>)}
      </ul>
    </article>

    <div class="switch" aria-hidden="true"><span>→</span></div>

    <article class="comparison-card after">
      <h3>{copy.after}</h3>
      <ul>
        {copy.afterItems.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </div>

  <blockquote>{copy.quote}</blockquote>
</section>

<style>
  .dbt-journey { margin: 2.5rem 0 3.25rem; }
  .journey-header { margin-bottom: 1.5rem; }
  .journey-header > span {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-blue, #557cb5);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .journey-header h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.03em;
  }
  .journey-header p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  .architecture-track {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0.45rem;
    align-items: stretch;
  }
  .stage {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-bg-secondary);
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }
  .stage--dbt {
    border-color: var(--color-blue-border, var(--color-accent));
    background: linear-gradient(155deg, var(--color-blue-muted, var(--color-accent-muted)), var(--color-bg-secondary) 60%);
  }
  .stage-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }
  .number {
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-blue, #668cc2);
    background: var(--color-bg-elevated);
  }
  .icon svg { width: 18px; height: 18px; }
  .stage h3 { margin: 0 0 0.45rem; font-size: 0.92rem; }
  .stage p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .arrow {
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
  }
  .comparison {
    display: grid;
    grid-template-columns: 1fr 58px 1fr;
    gap: 0.75rem;
    align-items: stretch;
    margin-top: 1.5rem;
  }
  .comparison-card {
    padding: 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-bg-secondary);
  }
  .comparison-card h3 { margin: 0 0 0.85rem; font-size: 1rem; }
  .comparison-card ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .comparison-card li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .before li::before,
  .after li::before {
    position: absolute;
    left: 0;
    font-weight: 900;
  }
  .before li::before { content: '−'; color: #b96b6b; }
  .after li::before { content: '✓'; color: #4f8f74; }
  .switch { display: grid; place-items: center; }
  .switch span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-blue-border, var(--color-border));
    border-radius: 50%;
    color: var(--color-blue, #668cc2);
    background: var(--color-bg-elevated);
    font-size: 1.25rem;
  }
  blockquote {
    margin: 1.5rem 0 0;
    padding: 1.15rem 1.3rem;
    border-left: 3px solid var(--color-blue, #668cc2);
    border-radius: 0 14px 14px 0;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    font-weight: 600;
    line-height: 1.65;
  }
  @media (hover: hover) and (pointer: fine) {
    .stage:hover {
      transform: translateY(-3px);
      border-color: var(--color-blue-border, var(--color-text-muted));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .stage {
      opacity: 0.25;
      transform: translateY(10px);
    }
    .dbt-journey.is-visible .stage {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 900px) {
    .architecture-track { grid-template-columns: 1fr; }
    .arrow { height: 24px; transform: rotate(90deg); }
    .comparison { grid-template-columns: 1fr; }
    .switch { height: 42px; }
    .switch span { transform: rotate(90deg); }
  }
</style>

<script>
  function initialiseDbtJourney() {
    document.querySelectorAll('[data-dbt-journey]').forEach((element) => {
      if (!(element instanceof HTMLElement)) return;
      if (element.dataset.ready === 'true') return;
      element.dataset.ready = 'true';

      if (!('IntersectionObserver' in window)) {
        element.classList.add('is-visible');
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            element.classList.add('is-visible');
            observer.unobserve(element);
          });
        },
        { threshold: 0.18 }
      );

      observer.observe(element);
    });
  }

  document.addEventListener('astro:page-load', initialiseDbtJourney);
  initialiseDbtJourney();
</script>
