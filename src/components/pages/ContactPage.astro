---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../SEO.astro';
import SiteIcon from '../icons/SiteIcon.astro';
import profileImage from '../../assets/profile/gregorio-valverde.jpg';
import { siteConfig } from '../../config';
import { buildMailtoUrl } from '../../utils/contact';
import { type Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props as Props;

const copy = lang === 'es'
  ? {
      title: 'Contacto - Gregorio Valverde',
      description: 'Contacta con Gregorio Valverde para hablar sobre datos, tecnología, negocio, proyectos o ideas.',
      eyebrow: 'Contacto',
      heading: 'Hablemos de datos, tecnología y negocio.',
      intro: 'Si te interesa mi trabajo o quieres comentar un proyecto, una idea o un reto relacionado con datos, tecnología o negocio, puedes contactarme por estas vías.',
      availability: 'Normalmente respondo en pocos días.',
      location: 'Murcia, España',
      role: 'Data & Analytics Engineer',
      sendEmail: 'Enviar',
      copyEmail: 'Copiar',
      copied: 'Copiado',
      directLabel: 'Correo directo',
      socialLabel: 'También puedes encontrarme aquí',
      topicsLabel: 'Temas sobre los que podemos hablar',
      topics: ['Data Engineering', 'Business Intelligence', 'Arquitectura de datos', 'Power BI', 'Automatización', 'Transformación Digital'],
      emailSubject: 'Contacto desde tu portfolio',
      emailBody: 'Hola Gregorio,\n\nHe visto tu portfolio y me gustaría hablar contigo sobre...',
      portraitAlt: 'Retrato profesional de Gregorio Valverde',
      linkedInText: 'Perfil profesional y trayectoria',
      githubText: 'Proyectos y código',
      privacy: 'Sin formularios ni intermediarios: el mensaje se envía desde tu propio correo.',
    }
  : {
      title: 'Contact - Gregorio Valverde',
      description: 'Contact Gregorio Valverde to discuss data, technology, business, projects, or ideas.',
      eyebrow: 'Contact',
      heading: 'Let’s talk about data, technology, and business.',
      intro: 'If my work interests you or you want to discuss a project, an idea, or a challenge related to data, technology, or business, you can contact me through these channels.',
      availability: 'I usually reply within a few days.',
      location: 'Murcia, Spain',
      role: 'Data & Analytics Engineer',
      sendEmail: 'Send',
      copyEmail: 'Copy',
      copied: 'Copied',
      directLabel: 'Direct email',
      socialLabel: 'You can also find me here',
      topicsLabel: 'Topics we can discuss',
      topics: ['Data Engineering', 'Business Intelligence', 'Data Architecture', 'Power BI', 'Automation', 'Digital Transformation'],
      emailSubject: 'Contact from your portfolio',
      emailBody: 'Hi Gregorio,\n\nI found your portfolio and I would like to talk with you about...',
      portraitAlt: 'Professional portrait of Gregorio Valverde',
      linkedInText: 'Professional profile and experience',
      githubText: 'Projects and code',
      privacy: 'No forms or intermediaries: the message is sent from your own email account.',
    };

const mailtoUrl = buildMailtoUrl(
  siteConfig.author.email,
  copy.emailSubject,
  copy.emailBody,
);

const socialCards = [
  siteConfig.social.linkedin && {
    name: 'LinkedIn',
    description: copy.linkedInText,
    url: siteConfig.social.linkedin,
    icon: 'linkedin' as const,
  },
  siteConfig.social.github && {
    name: 'GitHub',
    description: copy.githubText,
    url: siteConfig.social.github,
    icon: 'github' as const,
  },
].filter(Boolean) as Array<{
  name: string;
  description: string;
  url: string;
  icon: 'linkedin' | 'github';
}>;
---

<BaseLayout lang={lang}>
  <SEO
    slot="head"
    title={copy.title}
    description={copy.description}
    type="website"
  />

  <div class="contact-page" data-contact-root data-email={siteConfig.author.email}>
    <section class="contact-hero" aria-labelledby="contact-heading">
      <div class="contact-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 id="contact-heading">{copy.heading}</h1>
        <p class="intro">{copy.intro}</p>

        <div class="profile-meta" aria-label={lang === 'es' ? 'Información profesional' : 'Professional information'}>
          <span><SiteIcon name="location" size={15} />{copy.location}</span>
          <span><SiteIcon name="user" size={15} />{copy.role}</span>
        </div>

        <div class="availability-note">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{copy.availability}</span>
        </div>
      </div>

      <div class="portrait-card">
        <div class="portrait-frame">
          <Image
            src={profileImage}
            alt={copy.portraitAlt}
            width={720}
            height={1082}
            loading="eager"
          />
        </div>
        <div class="portrait-caption">
          <strong>{siteConfig.author.name}</strong>
          <span>{siteConfig.author.title}</span>
        </div>
      </div>
    </section>

    <section class="email-panel" aria-labelledby="email-heading">
      <div class="email-panel-head">
        <div class="email-icon" aria-hidden="true">
          <SiteIcon name="mail" size={24} />
        </div>
        <div>
          <p class="panel-label">{copy.directLabel}</p>
          <h2 id="email-heading">{siteConfig.author.email}</h2>
        </div>
      </div>

      <div class="email-actions">
        <button
          type="button"
          class="action-button action-secondary copy-button"
          data-copy-email
          data-default-label={copy.copyEmail}
          data-success-label={copy.copied}
        >
          <span class="copy-default-icon"><SiteIcon name="copy" size={17} /></span>
          <span class="copy-success-icon" aria-hidden="true"><SiteIcon name="check" size={17} /></span>
          <span data-copy-label>{copy.copyEmail}</span>
        </button>

        <a href={mailtoUrl} class="action-button action-primary">
          <SiteIcon name="mail" size={17} />
          {copy.sendEmail}
        </a>
      </div>

      <p class="privacy-note">
        <SiteIcon name="check" size={14} />
        {copy.privacy}
      </p>
    </section>

    <section class="topics-section" aria-labelledby="topics-heading">
      <div class="section-heading">
        <p class="eyebrow">{copy.topicsLabel}</p>
        <span class="heading-line" aria-hidden="true"></span>
      </div>
      <h2 id="topics-heading" class="sr-only">{copy.topicsLabel}</h2>
      <div class="topic-list">
        {copy.topics.map((topic) => (
          <span><SiteIcon name="sparkles" size={14} />{topic}</span>
        ))}
      </div>
    </section>

    {socialCards.length > 0 && (
      <section class="social-section" aria-labelledby="social-heading">
        <div class="section-heading">
          <p id="social-heading" class="eyebrow">{copy.socialLabel}</p>
          <span class="heading-line" aria-hidden="true"></span>
        </div>

        <div class="social-grid">
          {socialCards.map((card) => (
            <a
              href={card.url}
              class="social-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="social-icon"><SiteIcon name={card.icon} size={22} /></span>
              <span class="social-copy">
                <strong>{card.name}</strong>
                <span>{card.description}</span>
              </span>
              <SiteIcon name="external" size={15} />
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    function initContactPage() {
      document.querySelectorAll<HTMLElement>('[data-contact-root]').forEach((root) => {
        if (root.dataset.ready === 'true') return;
        root.dataset.ready = 'true';

        const email = root.dataset.email || '';
        const button = root.querySelector<HTMLButtonElement>('[data-copy-email]');
        const label = root.querySelector<HTMLElement>('[data-copy-label]');
        if (!button || !label || !email) return;

        let resetTimer: number | undefined;

        const fallbackCopy = (value: string) => {
          const textArea = document.createElement('textarea');
          textArea.value = value;
          textArea.setAttribute('readonly', '');
          textArea.style.position = 'fixed';
          textArea.style.opacity = '0';
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          textArea.remove();
        };

        button.addEventListener('click', async () => {
          try {
            if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(email);
            else fallbackCopy(email);

            button.dataset.copied = 'true';
            label.textContent = button.dataset.successLabel || 'Copied';
            window.clearTimeout(resetTimer);
            resetTimer = window.setTimeout(() => {
              button.dataset.copied = 'false';
              label.textContent = button.dataset.defaultLabel || 'Copy';
            }, 2200);
          } catch {
            fallbackCopy(email);
            button.dataset.copied = 'true';
            label.textContent = button.dataset.successLabel || 'Copied';
          }
        });
      });
    }

    document.addEventListener('astro:page-load', initContactPage);
    initContactPage();
  </script>

  <style>
    .contact-page {
      width: min(100%, 1080px);
      margin: 0 auto;
      padding: clamp(2.8rem, 7vw, 5.5rem) 1.5rem 6rem;
    }

    .contact-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(250px, 0.7fr);
      gap: clamp(2.25rem, 7vw, 5rem);
      align-items: center;
      padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    }

    .eyebrow,
    .panel-label {
      margin: 0;
      color: var(--color-blue);
      font-size: 0.7rem;
      font-weight: 750;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .contact-copy > .eyebrow { margin-bottom: 1rem; }

    .contact-copy h1 {
      max-width: 730px;
      margin: 0 0 1.35rem;
      color: var(--color-text);
      font-size: clamp(2.45rem, 7vw, 5.25rem);
      font-weight: 720;
      letter-spacing: -0.055em;
      line-height: 1.02;
      text-wrap: balance;
    }

    .intro {
      max-width: 670px;
      margin: 0 0 1.5rem;
      color: var(--color-text-secondary);
      font-size: clamp(1rem, 2vw, 1.14rem);
      line-height: 1.75;
    }

    .profile-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1.2rem;
      margin-bottom: 1.1rem;
    }

    .profile-meta span,
    .availability-note {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--color-text-muted);
      font-size: 0.82rem;
    }

    .profile-meta :global(svg) { color: var(--color-blue); }

    .availability-note {
      width: fit-content;
      padding: 0.48rem 0.7rem;
      border: 1px solid var(--color-blue-border);
      border-radius: 999px;
      background: linear-gradient(145deg, var(--color-navy-surface), var(--color-bg-secondary));
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-blue);
      box-shadow: 0 0 0 4px var(--color-blue-muted);
    }

    .portrait-card {
      justify-self: end;
      width: min(100%, 310px);
      overflow: hidden;
      border: 1px solid var(--color-blue-border);
      border-radius: 24px;
      background: var(--gradient-card), var(--color-bg-secondary);
      box-shadow: var(--shadow-lg);
      transform: rotate(1.2deg);
      transition: transform var(--transition-slow), border-color var(--transition-slow);
    }

    .portrait-card:hover {
      border-color: var(--color-blue);
      transform: rotate(0deg) translateY(-3px);
    }

    .portrait-frame {
      aspect-ratio: 4 / 4.6;
      overflow: hidden;
      background: #fff;
    }

    .portrait-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 15%;
    }

    .portrait-caption {
      display: grid;
      gap: 0.2rem;
      padding: 1rem 1.1rem 1.1rem;
    }

    .portrait-caption strong {
      color: var(--color-text);
      font-size: 0.92rem;
    }

    .portrait-caption span {
      color: var(--color-text-muted);
      font-size: 0.74rem;
    }

    .email-panel {
      position: relative;
      overflow: hidden;
      padding: clamp(1.35rem, 4vw, 2.25rem);
      border: 1px solid var(--color-blue-border);
      border-radius: 24px;
      background:
        radial-gradient(circle at 92% 0%, var(--color-blue-muted), transparent 38%),
        linear-gradient(145deg, color-mix(in srgb, var(--color-navy) 18%, var(--color-bg-secondary)), var(--color-bg-elevated));
      box-shadow: var(--shadow-md);
    }

    .email-panel::after {
      content: '';
      position: absolute;
      right: -70px;
      bottom: -95px;
      width: 220px;
      height: 220px;
      border: 1px solid var(--color-blue-border);
      border-radius: 50%;
      opacity: 0.45;
      pointer-events: none;
    }

    .email-panel-head {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.45rem;
    }

    .email-icon {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      width: 52px;
      height: 52px;
      border: 1px solid var(--color-blue-border);
      border-radius: 15px;
      color: var(--color-blue);
      background: color-mix(in srgb, var(--color-navy) 38%, var(--color-bg));
    }

    .panel-label { margin-bottom: 0.3rem; }

    .email-panel h2 {
      margin: 0;
      color: var(--color-text);
      font-size: clamp(1.2rem, 3vw, 1.8rem);
      font-weight: 650;
      letter-spacing: -0.025em;
      overflow-wrap: anywhere;
    }

    .email-actions {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
    }

    .action-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 45px;
      min-width: 118px;
      padding: 0.72rem 1rem;
      border-radius: 10px;
      font: inherit;
      font-size: 0.82rem;
      font-weight: 720;
      text-decoration: none;
      cursor: pointer;
      transition: transform var(--transition-base), border-color var(--transition-base), background var(--transition-base), opacity var(--transition-base);
    }

    .action-primary {
      border: 1px solid var(--color-blue-border);
      background: var(--gradient-blue);
      color: #ffffff;
    }

    .action-primary:hover {
      color: #ffffff;
      opacity: 0.92;
      transform: translateY(-1px);
    }

    .action-secondary {
      border: 1px solid var(--color-blue-border);
      background: var(--color-navy-surface);
      color: var(--color-text-secondary);
    }

    .action-secondary:hover {
      border-color: var(--color-blue);
      color: var(--color-text);
      background: color-mix(in srgb, var(--color-navy) 42%, var(--color-bg-elevated));
      transform: translateY(-1px);
    }

    .copy-success-icon { display: none; }

    .copy-button[data-copied='true'] {
      border-color: var(--color-blue);
      color: var(--color-accent-hover);
    }

    .copy-button[data-copied='true'] .copy-default-icon { display: none; }
    .copy-button[data-copied='true'] .copy-success-icon { display: inline-flex; }

    .privacy-note {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin: 1rem 0 0;
      color: var(--color-text-muted);
      font-size: 0.72rem;
      line-height: 1.5;
    }

    .privacy-note :global(svg) { color: var(--color-blue); }

    .topics-section,
    .social-section { padding-top: clamp(3rem, 7vw, 5rem); }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.15rem;
    }

    .heading-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, var(--color-blue-border), transparent);
    }

    .topic-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .topic-list span {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.55rem 0.78rem;
      border: 1px solid color-mix(in srgb, var(--color-blue-border) 58%, var(--color-border));
      border-radius: 999px;
      color: var(--color-text-secondary);
      background: linear-gradient(145deg, var(--color-navy-surface), var(--color-bg-secondary));
      font-size: 0.78rem;
    }

    .topic-list :global(svg) { color: var(--color-blue); }

    .social-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .social-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.9rem;
      align-items: center;
      padding: 1.05rem;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      color: var(--color-text-secondary);
      background: var(--gradient-card), var(--color-bg-secondary);
      text-decoration: none;
      transition: transform var(--transition-base), border-color var(--transition-base), background var(--transition-base);
    }

    .social-card:hover {
      border-color: var(--color-blue-border);
      color: var(--color-text);
      background: color-mix(in srgb, var(--color-navy) 24%, var(--color-bg-elevated));
      transform: translateY(-2px);
    }

    .social-icon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--color-blue-border);
      border-radius: 12px;
      color: var(--color-blue);
      background: color-mix(in srgb, var(--color-navy) 32%, var(--color-bg));
    }

    .social-copy {
      display: grid;
      gap: 0.18rem;
    }

    .social-copy strong {
      color: var(--color-text);
      font-size: 0.9rem;
    }

    .social-copy span {
      color: var(--color-text-muted);
      font-size: 0.74rem;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 760px) {
      .contact-page {
        padding-right: 1rem;
        padding-left: 1rem;
      }

      .contact-hero { grid-template-columns: 1fr; }

      .portrait-card {
        justify-self: center;
        width: min(82vw, 300px);
        transform: none;
      }

      .social-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 520px) {
      .contact-page { padding-top: 2.35rem; }
      .contact-copy h1 { font-size: clamp(2.35rem, 13vw, 3.25rem); }

      .email-panel-head {
        align-items: flex-start;
        gap: 0.75rem;
      }

      .email-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
      }

      .email-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .action-button {
        width: 100%;
        min-width: 0;
      }
    }

    @media (max-width: 380px) {
      .email-actions { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      .portrait-card,
      .action-button,
      .social-card { transition: none; }

      .portrait-card:hover,
      .action-button:hover,
      .social-card:hover { transform: none; }
    }
  </style>
</BaseLayout>
