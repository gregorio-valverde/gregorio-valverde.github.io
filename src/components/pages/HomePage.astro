---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../SEO.astro';
import StructuredData from '../StructuredData.astro';
import ProjectCard from '../ProjectCard.astro';
import HomePublicationsCarousel from '../HomePublicationsCarousel.astro';
import SiteIcon from '../icons/SiteIcon.astro';
import profileImage from '../../assets/profile/gregorio-valverde.jpg';
import { siteConfig } from '../../config';
import { buildMailtoUrl } from '../../utils/contact';
import {
  contentLang,
  contentSlug,
  localizePath,
  translateTemplate,
  ui,
  type Lang,
} from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props as Props;
const copy = ui[lang];
const allProjects = (await getCollection('projects')).filter(
  (project) => contentLang(project.id) === lang,
);
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);

const homeDescription = lang === 'es'
  ? 'Portfolio profesional de Gregorio Valverde centrado en Business Intelligence, Data Engineering y Analytics aplicados a operaciones de negocio y transformación digital.'
  : siteConfig.description;

const extra = lang === 'es'
  ? {
      emailDirect: 'Enviar email',
      emailSubject: 'Contacto desde tu portfolio',
      contactPage: 'Ver todas las opciones de contacto',
      location: 'Murcia, España',
      profileFocus: 'Data Engineering · BI · Transformación Digital',
      profileText: 'Diseño soluciones de datos que conectan la parte técnica con necesidades reales de negocio.',
      profileLabel: 'Perfil profesional',
      projectsEyebrow: 'Casos reales',
      publicationsAnchor: 'Ver publicaciones',
      finalText: 'Si te interesa mi trabajo o quieres comentar algún proyecto o idea, puedes contactarme directamente por las vías disponibles.',
    }
  : {
      emailDirect: 'Send email',
      emailSubject: 'Contact from your portfolio',
      contactPage: 'View all contact options',
      location: 'Murcia, Spain',
      profileFocus: 'Data Engineering · BI · Digital Transformation',
      profileText: 'I design data solutions that connect technical implementation with real business needs.',
      profileLabel: 'Professional profile',
      projectsEyebrow: 'Real case studies',
      publicationsAnchor: 'View publications',
      finalText: 'If my work interests you or you want to discuss a project or idea, you can contact me directly through the available channels.',
    };

const emailUrl = buildMailtoUrl(siteConfig.author.email, extra.emailSubject);
---

<BaseLayout lang={lang}>
  <SEO
    slot="head"
    title={`${siteConfig.author.name} - ${siteConfig.author.title}`}
    description={homeDescription}
    type="website"
    noSuffix
  />
  <StructuredData type="WebSite" lang={lang} data={{ description: homeDescription }} />
  <StructuredData
    type="Person"
    lang={lang}
    data={{
      description: lang === 'es'
        ? 'Ingeniero de datos y analítica con formación en Física y experiencia construyendo pipelines, modelos analíticos y cuadros de mando.'
        : siteConfig.author.bio,
    }}
  />

  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">{copy.home.eyebrow}</p>
        <h1 id="home-title" class="hero-title">{copy.home.title}</h1>
        <p class="hero-sub">{copy.home.subtitle}</p>
        <p class="hero-meta">{siteConfig.author.name} · {siteConfig.author.title}</p>

        <div class="hero-tags" aria-label={lang === 'es' ? 'Tecnologías y áreas' : 'Technologies and areas'}>
          <span>Business Intelligence</span>
          <span>Data Engineering</span>
          <span>Analytics</span>
          <span>Power BI</span>
          <span>Airflow</span>
          <span>dbt</span>
          <span>SQL Server</span>
          <span>Python</span>
        </div>

        <div class="hero-actions">
          <a href={localizePath('/projects', lang)} class="button button-primary">
            {copy.home.viewProjects}
            <SiteIcon name="arrow-right" size={17} />
          </a>

          <a href={emailUrl} class="button button-secondary">
            <SiteIcon name="mail" size={17} />
            {extra.emailDirect}
          </a>
        </div>

        <div class="hero-links">
          <a href={localizePath('/publications', lang)}>{extra.publicationsAnchor}</a>
          <span aria-hidden="true">·</span>
          <a href={localizePath('/contact', lang)}>{extra.contactPage}</a>
        </div>
      </div>

      <aside class="profile-card" aria-label={extra.profileLabel}>
        <div class="profile-image-frame">
          <Image
            src={profileImage}
            alt={lang === 'es' ? 'Retrato profesional de Gregorio Valverde' : 'Professional portrait of Gregorio Valverde'}
            loading="eager"
            width={720}
            height={1082}
          />
          <div class="profile-image-overlay" aria-hidden="true"></div>
        </div>

        <div class="profile-card-content">
          <div class="profile-location">
            <SiteIcon name="location" size={15} />
            <span>{extra.location}</span>
          </div>
          <strong>{siteConfig.author.name}</strong>
          <span class="profile-focus">{extra.profileFocus}</span>
          <p>{extra.profileText}</p>
        </div>
      </aside>
    </section>

    <section class="intro-section">
      <p>{translateTemplate(copy.home.intro1, { name: siteConfig.author.name, title: siteConfig.author.title })}</p>
      <p>{copy.home.intro2}</p>
      <a href={localizePath('/journey', lang)} class="text-link">
        {copy.home.journeyLink}
        <SiteIcon name="arrow-right" size={15} />
      </a>
    </section>

    <section class="featured-projects" aria-labelledby="featured-projects-title">
      <div class="section-header">
        <div>
          <p class="eyebrow">{extra.projectsEyebrow}</p>
          <h2 id="featured-projects-title">{copy.home.featuredProjects}</h2>
        </div>
        <a href={localizePath('/projects', lang)} class="section-link">
          {copy.home.viewAll}
          <SiteIcon name="arrow-right" size={15} />
        </a>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="project-grid">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              slug={contentSlug(project.id)}
              outcomeSummary={project.data.outcomeSummary}
              role={project.data.role}
              year={project.data.year}
              techStack={project.data.techStack}
              featured={project.data.featured}
              status={project.data.status}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="project-grid">
          <a href={localizePath('/projects', lang)} class="project-fallback-card">
            <span class="project-role">{copy.home.fallbackDataEngineering}</span>
            <h3>{copy.home.fallbackProject1}</h3>
            <p>{copy.home.fallbackProject1Description}</p>
          </a>
          <a href={localizePath('/projects', lang)} class="project-fallback-card">
            <span class="project-role">{copy.home.fallbackBI}</span>
            <h3>{copy.home.fallbackProject2}</h3>
            <p>{copy.home.fallbackProject2Description}</p>
          </a>
        </div>
      )}
    </section>

    <HomePublicationsCarousel lang={lang} />

    <section class="home-contact-cta">
      <div>
        <p class="eyebrow">{lang === 'es' ? 'Contacto directo' : 'Direct contact'}</p>
        <h2>{copy.home.ctaTitle}</h2>
        <p>{extra.finalText}</p>
      </div>

      <div class="cta-buttons">
        <a href={emailUrl} class="button button-primary">
          <SiteIcon name="mail" size={17} />
          {extra.emailDirect}
        </a>
        <a href={localizePath('/contact', lang)} class="button button-secondary">
          {copy.home.getInTouch}
          <SiteIcon name="arrow-right" size={17} />
        </a>
      </div>
    </section>
  </div>

  <style>
    .home-page {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 1.5rem 4.5rem;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
      gap: clamp(2.2rem, 6vw, 5.5rem);
      align-items: center;
      padding: clamp(3rem, 7vw, 5.5rem) 0 4rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-blue-border) 38%, var(--color-border));
      margin-bottom: 3.5rem;
    }

    .hero-copy { min-width: 0; }

    .eyebrow {
      margin: 0 0 0.9rem;
      color: var(--color-blue);
      font-size: 0.72rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero-title {
      max-width: 760px;
      margin: 0 0 1.25rem;
      color: var(--color-text);
      font-size: clamp(2.35rem, 6vw, 5rem);
      font-weight: 720;
      line-height: 1.02;
      letter-spacing: -0.058em;
      text-wrap: balance;
    }

    .hero-sub {
      max-width: 650px;
      margin: 0 0 1rem;
      color: var(--color-text-secondary);
      font-size: clamp(1rem, 1.5vw, 1.14rem);
      line-height: 1.7;
    }

    .hero-meta {
      margin: 0 0 1.35rem;
      color: var(--color-text-muted);
      font-size: 0.88rem;
    }

    .hero-tags {
      display: flex;
      max-width: 720px;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-bottom: 2rem;
    }

    .hero-tags span {
      display: inline-flex;
      align-items: center;
      padding: 0.42rem 0.72rem;
      border: 1px solid color-mix(in srgb, var(--color-blue-border) 54%, var(--color-border));
      border-radius: 999px;
      background: linear-gradient(145deg, var(--color-navy-surface), color-mix(in srgb, var(--color-bg-secondary) 90%, transparent));
      color: var(--color-text-secondary);
      font-size: 0.72rem;
      font-weight: 650;
    }

    .hero-actions,
    .cta-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .button {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.74rem 1.15rem;
      border: 1px solid transparent;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 720;
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, color 180ms ease, opacity 180ms ease;
    }

    .button-primary {
      background: var(--gradient-blue);
      color: #ffffff;
      box-shadow: 0 9px 24px rgba(10, 40, 65, 0.18);
    }

    .button-secondary {
      border-color: var(--color-blue-border);
      background: linear-gradient(145deg, var(--color-navy-surface), var(--color-bg-secondary));
      color: var(--color-text);
    }

    .button:hover { transform: translateY(-2px); }

    .button-primary:hover {
      opacity: 0.92;
      color: #ffffff;
    }

    .button-secondary:hover {
      border-color: var(--color-blue);
      background: color-mix(in srgb, var(--color-navy) 40%, var(--color-bg-elevated));
      color: var(--color-text);
    }

    .hero-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      margin-top: 1rem;
      color: var(--color-text-muted);
      font-size: 0.76rem;
    }

    .hero-links a {
      color: var(--color-text-muted);
      text-decoration: none;
    }

    .hero-links a:hover { color: var(--color-blue); }

    .profile-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--color-blue-border);
      border-radius: 26px;
      background: var(--gradient-card), var(--color-bg-secondary);
      box-shadow: var(--shadow-lg);
    }

    .profile-card::before {
      position: absolute;
      z-index: 0;
      top: -120px;
      right: -100px;
      width: 250px;
      height: 250px;
      border-radius: 50%;
      background: var(--color-blue-muted);
      content: '';
      filter: blur(10px);
      pointer-events: none;
    }

    .profile-image-frame {
      position: relative;
      z-index: 1;
      aspect-ratio: 4 / 4.55;
      overflow: hidden;
      border-bottom: 1px solid var(--color-border-subtle);
      background: #f4f5f6;
    }

    .profile-image-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 22%;
    }

    .profile-image-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 70%, rgba(23, 29, 36, 0.12));
      pointer-events: none;
    }

    .profile-card-content {
      position: relative;
      z-index: 1;
      padding: 1.25rem;
    }

    .profile-location {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.8rem;
      color: var(--color-text-muted);
      font-size: 0.72rem;
      font-weight: 650;
    }

    .profile-card-content strong {
      display: block;
      margin-bottom: 0.25rem;
      color: var(--color-text);
      font-size: 1.06rem;
      letter-spacing: -0.015em;
    }

    .profile-focus {
      display: block;
      color: var(--color-blue);
      font-size: 0.74rem;
      font-weight: 680;
      line-height: 1.4;
    }

    .profile-card-content p {
      margin: 0.85rem 0 0;
      color: var(--color-text-secondary);
      font-size: 0.88rem;
      line-height: 1.6;
    }

    .intro-section {
      max-width: 760px;
      margin-bottom: 4.5rem;
      color: var(--color-text-secondary);
      font-size: 1.03rem;
      line-height: 1.75;
    }

    .intro-section p { margin: 0 0 1rem; }
    .intro-section p:first-child { color: var(--color-text); }

    .text-link,
    .section-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--color-text-secondary);
      font-size: 0.84rem;
      font-weight: 700;
      text-decoration: none;
    }

    .text-link {
      margin-top: 0.25rem;
      color: var(--color-blue);
    }

    .text-link:hover,
    .section-link:hover { color: var(--color-accent-hover); }

    .featured-projects { margin-bottom: 4.5rem; }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .section-header h2 {
      margin: 0;
      color: var(--color-text);
      font-size: clamp(1.45rem, 3vw, 2rem);
      font-weight: 720;
      line-height: 1.15;
      letter-spacing: -0.035em;
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .project-fallback-card {
      display: block;
      min-height: 180px;
      padding: 1.4rem;
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background: var(--gradient-card), var(--color-bg-secondary);
      color: inherit;
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .project-fallback-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-blue-border);
      background: color-mix(in srgb, var(--color-navy) 26%, var(--color-bg-elevated));
    }

    .project-role {
      display: block;
      margin-bottom: 0.75rem;
      color: var(--color-blue);
      font-size: 0.68rem;
      font-weight: 750;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .project-fallback-card h3 {
      margin: 0 0 0.75rem;
      color: var(--color-text);
      font-size: 1.2rem;
      line-height: 1.25;
    }

    .project-fallback-card p {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .home-contact-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: clamp(2rem, 5vw, 3rem);
      border: 1px solid var(--color-blue-border);
      border-radius: 24px;
      background:
        radial-gradient(circle at 90% 15%, var(--color-blue-muted), transparent 38%),
        var(--gradient-card),
        var(--color-bg-secondary);
      box-shadow: 0 18px 42px rgba(5, 20, 33, 0.14);
    }

    .home-contact-cta > div:first-child { max-width: 620px; }

    .home-contact-cta h2 {
      margin: 0 0 0.7rem;
      color: var(--color-text);
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      line-height: 1.15;
      letter-spacing: -0.035em;
    }

    .home-contact-cta p:last-child {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .cta-buttons { flex-shrink: 0; }

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: minmax(0, 1fr) minmax(250px, 0.55fr);
        gap: 2rem;
      }

      .profile-card-content p { display: none; }

      .home-contact-cta {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 720px) {
      .home-page { padding: 0 1rem 3.5rem; }

      .hero {
        grid-template-columns: 1fr;
        padding: 3rem 0 3rem;
        margin-bottom: 2.8rem;
      }

      .profile-card {
        display: grid;
        grid-template-columns: 132px minmax(0, 1fr);
        align-items: stretch;
        width: 100%;
        max-width: 520px;
        margin-inline: auto;
      }

      .profile-image-frame {
        height: 100%;
        min-height: 170px;
        aspect-ratio: auto;
        border-right: 1px solid var(--color-border-subtle);
        border-bottom: 0;
      }

      .profile-card-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .project-grid { grid-template-columns: 1fr; }

      .section-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .home-contact-cta { padding: 1.5rem; }
    }

    @media (max-width: 480px) {
      .hero-title { font-size: 2.35rem; }

      .hero-actions,
      .cta-buttons {
        width: 100%;
        flex-direction: column;
      }

      .button { width: 100%; }

      .profile-card { grid-template-columns: 112px minmax(0, 1fr); }
      .profile-card-content { padding: 1rem; }
      .profile-focus { font-size: 0.68rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .button,
      .project-fallback-card { transition: none; }

      .button:hover,
      .project-fallback-card:hover { transform: none; }
    }
  </style>
</BaseLayout>
