---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../SEO.astro';
import BackLink from '../BackLink.astro';
import PublicationVisual from '../PublicationVisual.astro';
import SiteIcon from '../icons/SiteIcon.astro';
import profileImage from '../../assets/profile/gregorio-valverde.jpg';
import { siteConfig } from '../../config';
import { getPublicationMedia } from '../../data/publicationMedia';
import { buildMailtoUrl } from '../../utils/contact';
import {
  contentSlug,
  localizePath,
  localeCode,
  ui,
  type Lang,
} from '../../i18n';

interface Props {
  entry: CollectionEntry<'publications'>;
  lang?: Lang;
}

const { entry, lang = 'es' } = Astro.props as Props;
const copy = ui[lang].publications;
const slug = contentSlug(entry.id);
const media = getPublicationMedia(slug, lang);
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat(localeCode(lang), {
  month: 'long',
  year: 'numeric',
}).format(entry.data.date);

const extra = lang === 'es'
  ? {
      authorLabel: 'Publicado por',
      contactEyebrow: '¿Quieres comentar esta idea?',
      contactTitle: 'Hablemos de datos, ingeniería y negocio.',
      contactText: 'Puedes escribirme directamente por correo. Leo personalmente todos los mensajes.',
      contactButton: 'Enviar email',
      contactSubject: `Sobre tu publicación: ${entry.data.title}`,
      allPublications: 'Volver a publicaciones',
      coverAlt: `Imagen de portada de la publicación «${entry.data.title}»`,
    }
  : {
      authorLabel: 'Published by',
      contactEyebrow: 'Want to discuss this idea?',
      contactTitle: 'Let’s talk about data, engineering, and business.',
      contactText: 'You can email me directly. I personally read every message.',
      contactButton: 'Send email',
      contactSubject: `About your publication: ${entry.data.title}`,
      allPublications: 'Back to publications',
      coverAlt: `Cover image for “${entry.data.title}”`,
    };

const emailUrl = buildMailtoUrl(siteConfig.author.email, extra.contactSubject);
---

<BaseLayout lang={lang}>
  <SEO
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
    type="article"
    publishDate={entry.data.date}
    image={media.image.src}
  />

  <article class="publication-detail">
    <header class="publication-header">
      <div class="detail-meta">
        <span class:list={['type-badge', `type-${entry.data.type}`]}>
          {copy.types[entry.data.type]}
        </span>
        <time datetime={entry.data.date.toISOString()}>{date}</time>
      </div>

      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>

      <div class="author-row">
        <div class="author-avatar">
          <Image
            src={profileImage}
            alt="Gregorio Valverde"
            width={96}
            height={96}
            loading="eager"
          />
        </div>
        <div class="author-copy">
          <span>{extra.authorLabel}</span>
          <strong>{siteConfig.author.name}</strong>
        </div>
      </div>

      {entry.data.tags.length > 0 && (
        <div class="tags" aria-label={lang === 'es' ? 'Etiquetas' : 'Tags'}>
          {entry.data.tags.map((tag: string) => <span>{tag}</span>)}
        </div>
      )}
    </header>

    <div class="publication-cover" aria-label={extra.coverAlt}>
      <PublicationVisual
        slug={slug}
        lang={lang}
        variant="detail"
        priority
      />
    </div>

    <div class="publication-content-shell">
      <div class="prose publication-body">
        <Content />
      </div>
    </div>

    <footer class="publication-footer">
      <section class="article-contact">
        <div class="contact-icon" aria-hidden="true">
          <SiteIcon name="mail" size={22} />
        </div>
        <div class="contact-copy">
          <p class="contact-eyebrow">{extra.contactEyebrow}</p>
          <h2>{extra.contactTitle}</h2>
          <p>{extra.contactText}</p>
        </div>
        <a href={emailUrl} class="contact-button">
          <SiteIcon name="mail" size={17} />
          {extra.contactButton}
        </a>
      </section>

      <BackLink
        href={localizePath('/publications', lang)}
        text={extra.allPublications}
      />
    </footer>
  </article>

  <style>
    .publication-detail {
      width: min(100%, 1080px);
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem 5.5rem;
    }

    .publication-header {
      max-width: 820px;
      margin: 0 auto 2rem;
    }

    .detail-meta {
      display: flex;
      gap: 0.85rem;
      align-items: center;
      margin-bottom: 1.2rem;
      color: var(--color-text-muted);
      font-size: 0.78rem;
    }

    .detail-meta time { font-variant-numeric: tabular-nums; }

    .publication-header h1 {
      max-width: 800px;
      margin: 0 0 1.25rem;
      color: var(--color-text);
      font-size: clamp(2.25rem, 6vw, 4.7rem);
      font-weight: 720;
      letter-spacing: -0.052em;
      line-height: 1.02;
      text-wrap: balance;
    }

    .lead {
      max-width: 740px;
      margin: 0 0 1.5rem;
      color: var(--color-text-secondary);
      font-size: clamp(1.05rem, 2vw, 1.22rem);
      line-height: 1.72;
    }

    .author-row {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      width: fit-content;
      margin: 1.5rem 0 1rem;
    }

    .author-avatar {
      width: 44px;
      height: 44px;
      overflow: hidden;
      border: 1px solid var(--color-blue-border);
      border-radius: 50%;
      background: var(--color-bg-secondary);
      box-shadow: var(--shadow-sm);
    }

    .author-avatar :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 22%;
    }

    .author-copy {
      display: grid;
      gap: 0.1rem;
    }

    .author-copy span {
      color: var(--color-text-muted);
      font-size: 0.7rem;
      letter-spacing: 0.055em;
      text-transform: uppercase;
    }

    .author-copy strong {
      color: var(--color-text);
      font-size: 0.9rem;
      font-weight: 650;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 1rem;
    }

    .tags span,
    .type-badge {
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
    }

    .tags span {
      padding: 0.32rem 0.58rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-navy) 18%, var(--color-bg-secondary));
      font-size: 0.68rem;
    }

    .type-badge {
      padding: 0.3rem 0.52rem;
      border-radius: 6px;
      background: var(--color-navy-surface);
      font-size: 0.65rem;
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .type-article {
      border-color: rgba(122, 169, 213, 0.36);
      color: #93bee5;
    }

    .type-reflection {
      border-color: rgba(169, 191, 210, 0.34);
      color: #c2d3e1;
    }

    .type-decision {
      border-color: var(--color-blue-border);
      color: var(--color-blue);
      background: color-mix(in srgb, var(--color-navy) 58%, transparent);
    }

    .publication-cover {
      width: min(100%, 760px);
      margin: 2.25rem auto clamp(3rem, 7vw, 5rem);
    }

    .publication-content-shell {
      width: min(100%, 800px);
      margin: 0 auto;
    }

    .publication-body {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      overflow-wrap: anywhere;
    }

    .publication-body :global(img) {
      display: block;
      width: auto;
      max-width: 100%;
      height: auto;
      margin: 1.8rem auto;
    }

    .publication-body :global(figure) {
      width: 100%;
      max-width: 100%;
      margin: 2rem auto;
      text-align: center;
    }

    .publication-body :global(figure img) { margin-inline: auto; }

    .publication-body :global(figcaption) {
      max-width: 90%;
      margin: 0.65rem auto 0;
      color: var(--color-text-muted);
      font-size: 0.78rem;
      line-height: 1.5;
      text-align: center;
    }

    .publication-body :global(video),
    .publication-body :global(iframe),
    .publication-body :global(svg) {
      max-width: 100%;
      margin-inline: auto;
    }

    .publication-body :global(table) {
      display: block;
      width: max-content;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .publication-body :global(pre) {
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .publication-footer {
      max-width: 860px;
      margin: clamp(3.5rem, 8vw, 6rem) auto 0;
    }

    .article-contact {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 1.25rem;
      align-items: center;
      margin-bottom: 2.5rem;
      padding: clamp(1.35rem, 3vw, 1.8rem);
      border: 1px solid var(--color-blue-border);
      border-radius: 20px;
      background:
        radial-gradient(circle at 85% 10%, var(--color-blue-muted), transparent 34%),
        var(--gradient-card),
        var(--color-bg-secondary);
      box-shadow: var(--shadow-sm);
    }

    .contact-icon {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 1px solid var(--color-blue-border);
      border-radius: 14px;
      color: var(--color-blue);
      background: color-mix(in srgb, var(--color-navy) 30%, var(--color-bg-elevated));
    }

    .contact-copy { min-width: 0; }

    .contact-eyebrow {
      margin: 0 0 0.3rem;
      color: var(--color-blue);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .contact-copy h2 {
      margin: 0 0 0.3rem;
      color: var(--color-text);
      font-size: 1.1rem;
      letter-spacing: -0.02em;
    }

    .contact-copy > p:last-child {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .contact-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 44px;
      padding: 0.72rem 1rem;
      border-radius: 10px;
      background: var(--gradient-blue);
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 750;
      text-decoration: none;
      white-space: nowrap;
      transition: transform var(--transition-base), opacity var(--transition-base);
    }

    .contact-button:hover {
      color: #ffffff;
      opacity: 0.9;
      transform: translateY(-1px);
    }

    @media (max-width: 820px) {
      .article-contact { grid-template-columns: auto minmax(0, 1fr); }

      .contact-button {
        grid-column: 1 / -1;
        width: 100%;
      }
    }

    @media (max-width: 560px) {
      .publication-detail {
        padding: 2.25rem 1rem 4rem;
      }

      .publication-header { margin-bottom: 1.4rem; }

      .publication-header h1 {
        font-size: clamp(2.15rem, 11.5vw, 3.25rem);
        letter-spacing: -0.045em;
      }

      .detail-meta {
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      .publication-cover {
        width: 100%;
        margin: 1.5rem auto 2.75rem;
      }

      .publication-body :global(img) {
        max-width: min(100%, 680px);
        margin: 1.35rem auto;
      }

      .publication-body :global(figure) { margin: 1.6rem auto; }

      .article-contact { grid-template-columns: 1fr; }

      .contact-icon {
        width: 42px;
        height: 42px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .contact-button { transition: none; }
      .contact-button:hover { transform: none; }
    }
  </style>
</BaseLayout>
