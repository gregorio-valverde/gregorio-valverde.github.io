---
import BaseLayout from '../../layouts/BaseLayout.astro';import SEO from '../SEO.astro';import BackLink from '../BackLink.astro';import { render, type CollectionEntry } from 'astro:content';import { localizePath, localeCode, ui, type Lang } from '../../i18n';
interface Props{entry:CollectionEntry<'publications'>;lang?:Lang}const {entry,lang='es'}=Astro.props as Props;const copy=ui[lang].publications;const {Content}=await render(entry);const date=new Intl.DateTimeFormat(localeCode(lang),{day:'numeric',month:'long',year:'numeric'}).format(entry.data.date);
---
<BaseLayout lang={lang}><SEO slot="head" title={entry.data.title} description={entry.data.description} type="article" publishDate={entry.data.date}/><main class="publication-detail"><div class="detail-meta"><span class:list={['type-badge',`type-${entry.data.type}`]}>{copy.types[entry.data.type]}</span><time>{date}</time></div><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><div class="tags">{entry.data.tags.map((t:string)=><span>{t}</span>)}</div><article class="prose publication-body"><Content /></article><BackLink href={localizePath('/publications',lang)} text={copy.heading}/></main><style>.publication-detail{max-width:800px;margin:0 auto;padding:2.5rem 1.5rem 5rem}.detail-meta{display:flex;gap:1rem;align-items:center;margin-bottom:1rem;color:var(--color-text-muted);font-size:.8rem}.publication-detail h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.08;letter-spacing:-.04em;margin-bottom:1.2rem}.lead{font-size:1.08rem;line-height:1.7;color:var(--color-text-secondary);margin-bottom:1rem}.tags{display:flex;gap:.45rem;flex-wrap:wrap;margin:1rem 0 2.5rem}.tags span,.type-badge{font-size:.7rem;padding:.3rem .55rem;border:1px solid var(--color-border);border-radius:999px;color:var(--color-text-muted)}.type-badge{border-radius:6px;text-transform:uppercase;font-weight:700}.publication-body{margin-bottom:3rem}</style></BaseLayout>
