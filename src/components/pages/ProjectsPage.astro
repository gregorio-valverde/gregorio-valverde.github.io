---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../SEO.astro';
import ProjectCard from '../ProjectCard.astro';
import PageStats from '../PageStats.astro';
import { getCollection } from 'astro:content';
import { contentLang, contentSlug, ui, type Lang } from '../../i18n';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const copy = ui[lang].projects;
const allProjects = (await getCollection('projects')).filter((project) => contentLang(project.id) === lang);
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) return a.data.order - b.data.order;
  if (a.data.order !== undefined) return -1;
  if (b.data.order !== undefined) return 1;
  return b.data.year - a.data.year;
});
const totalProjects = sortedProjects.length;
const featuredCount = sortedProjects.filter(p => p.data.featured).length;
---

<BaseLayout lang={lang}>
  <SEO slot="head" title={copy.title} description={copy.description} type="website" />
  <main class="page-container projects-page">
    <header class="page-header">
      <h1 class="page-title">{copy.heading}</h1>
      <p class="page-intro">{copy.intro}</p>
      <PageStats text={copy.stats(totalProjects, featuredCount)} />
    </header>
    {sortedProjects.length > 0 ? (
      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={contentSlug(project.id)}
            outcomeSummary={project.data.outcomeSummary}
            role={project.data.role}
            year={project.data.year}
            techStack={project.data.techStack}
            featured={project.data.featured}
            status={project.data.status}
            lang={lang}
          />
        ))}
      </div>
    ) : <p class="empty-state">{copy.empty}</p>}
  </main>

  <style>
    .projects-page {
      max-width: 1120px;
    }

    .projects-page .page-intro {
      max-width: none;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      align-items: stretch;
    }

    .projects-grid > :global(.project-card) {
      min-width: 0;
      height: 100%;
    }

    .projects-grid > :global(.project-card:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }

    @media (max-width: 760px) {
      .projects-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .projects-grid > :global(.project-card:last-child:nth-child(odd)) {
        grid-column: auto;
      }
    }
  </style>
</BaseLayout>
