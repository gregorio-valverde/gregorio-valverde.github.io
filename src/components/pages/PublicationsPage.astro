---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../SEO.astro';
import PublicationCard from '../PublicationCard.astro';
import {
  contentLang,
  ui,
  type Lang,
} from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props as Props;
const copy = ui[lang].publications;
const publications = (await getCollection('publications'))
  .filter((entry) => contentLang(entry.id) === lang && !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const leadPublication = publications.find((entry) => entry.data.featured) ?? publications[0];
const remainingPublications = publications.filter((entry) => entry.id !== leadPublication?.id);
const labels = lang === 'es'
  ? {
      eyebrow: 'Ideas, arquitectura y aprendizaje',
      featured: 'Publicación destacada',
      filtersLabel: 'Filtrar publicaciones',
      visible: 'publicaciones visibles',
    }
  : {
      eyebrow: 'Ideas, architecture, and learning',
      featured: 'Featured publication',
      filtersLabel: 'Filter publications',
      visible: 'visible publications',
    };
---

<BaseLayout lang={lang}>
  <SEO slot="head" title={copy.title} description={copy.description} type="website" />

  <div class="page-container publications-page" data-publications-root>
    <header class="publications-header">
      <p class="eyebrow">{labels.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
    </header>

    {leadPublication && (
      <section
        class="lead-publication publication-filter-item"
        data-type={leadPublication.data.type}
        aria-labelledby="featured-publication-title"
      >
        <p id="featured-publication-title" class="section-label">{labels.featured}</p>
        <PublicationCard
          entry={leadPublication}
          lang={lang}
          variant="featured"
          headingLevel="h2"
        />
      </section>
    )}

    <section class="publication-index" aria-labelledby="publication-index-title">
      <div class="index-heading">
        <div>
          <p class="section-label">{lang === 'es' ? 'Explorar contenido' : 'Explore content'}</p>
          <h2 id="publication-index-title">
            {lang === 'es' ? 'Todas las publicaciones' : 'All publications'}
          </h2>
        </div>
        <p class="visible-counter" data-visible-counter aria-live="polite">
          {publications.length} {labels.visible}
        </p>
      </div>

      <div class="publication-controls" role="group" aria-label={labels.filtersLabel}>
        <button type="button" class="filter active" data-filter="all" aria-pressed="true">
          {copy.all}<span>{publications.length}</span>
        </button>
        <button type="button" class="filter" data-filter="decision" aria-pressed="false">
          {copy.decision}<span>{publications.filter((entry) => entry.data.type === 'decision').length}</span>
        </button>
        <button type="button" class="filter" data-filter="reflection" aria-pressed="false">
          {copy.reflection}<span>{publications.filter((entry) => entry.data.type === 'reflection').length}</span>
        </button>
        <button type="button" class="filter" data-filter="article" aria-pressed="false">
          {copy.article}<span>{publications.filter((entry) => entry.data.type === 'article').length}</span>
        </button>
      </div>

      <div class="publication-grid" aria-live="polite">
        {remainingPublications.map((entry) => (
          <div class="publication-filter-item" data-type={entry.data.type}>
            <PublicationCard entry={entry} lang={lang} variant="grid" headingLevel="h2" />
          </div>
        ))}
      </div>

      <p class="filter-empty" hidden>{copy.empty}</p>
    </section>
  </div>

  <script>
    function initPublications() {
      document.querySelectorAll('[data-publications-root]').forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
        root.dataset.ready = 'true';

        const buttons = Array.from(root.querySelectorAll('.filter')).filter(
          (element): element is HTMLButtonElement => element instanceof HTMLButtonElement,
        );
        const items = Array.from(root.querySelectorAll('.publication-filter-item')).filter(
          (element): element is HTMLElement => element instanceof HTMLElement,
        );
        const empty = root.querySelector('.filter-empty');
        const visibleCounter = root.querySelector('[data-visible-counter]');
        const visibleLabel = visibleCounter?.textContent?.replace(/^\d+\s*/, '') ?? '';

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const filter = button.dataset.filter ?? 'all';
            buttons.forEach((currentButton) => {
              const active = currentButton === button;
              currentButton.classList.toggle('active', active);
              currentButton.setAttribute('aria-pressed', String(active));
            });

            let visible = 0;
            items.forEach((item) => {
              const show = filter === 'all' || item.dataset.type === filter;
              item.toggleAttribute('hidden', !show);
              if (show) visible += 1;
            });

            if (empty instanceof HTMLElement) {
              empty.toggleAttribute('hidden', visible !== 0);
            }

            if (visibleCounter instanceof HTMLElement) {
              visibleCounter.textContent = `${visible} ${visibleLabel}`;
            }
          });
        });
      });
    }

    document.addEventListener('astro:page-load', initPublications);
    initPublications();
  </script>

  <style>
    .publications-page {
      max-width: 1120px;
      margin: 0 auto;
      padding: clamp(2.8rem, 6vw, 5rem) 1.5rem 5rem;
    }

    .publications-header {
      max-width: 760px;
      margin-bottom: 2.75rem;
    }

    .eyebrow,
    .section-label {
      margin: 0 0 0.7rem;
      color: var(--color-blue);
      font-size: 0.7rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .publications-header h1 {
      margin: 0 0 1rem;
      color: var(--color-text);
      font-size: clamp(2.35rem, 6vw, 4.7rem);
      line-height: 1.02;
      letter-spacing: -0.055em;
    }

    .publications-header > p:last-child {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: clamp(1rem, 1.6vw, 1.12rem);
      line-height: 1.75;
    }

    .lead-publication { margin-bottom: 4rem; }

    .publication-index {
      padding-top: 2.4rem;
      border-top: 1px solid color-mix(in srgb, var(--color-blue-border) 42%, var(--color-border));
    }

    .index-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 1.35rem;
    }

    .index-heading h2 {
      margin: 0;
      color: var(--color-text);
      font-size: clamp(1.45rem, 3vw, 2rem);
      line-height: 1.2;
      letter-spacing: -0.035em;
    }

    .visible-counter {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.76rem;
      font-weight: 650;
      white-space: nowrap;
    }

    .publication-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: 0 0 1.8rem;
    }

    .filter {
      display: inline-flex;
      min-height: 38px;
      align-items: center;
      gap: 0.5rem;
      padding: 0.58rem 0.85rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--gradient-card), var(--color-bg-secondary);
      color: var(--color-text-secondary);
      cursor: pointer;
      font: inherit;
      font-size: 0.78rem;
      font-weight: 650;
      transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease;
    }

    .filter span {
      display: inline-grid;
      min-width: 20px;
      height: 20px;
      place-items: center;
      border-radius: 999px;
      background: var(--color-navy-surface);
      color: var(--color-text-muted);
      font-size: 0.64rem;
    }

    .filter:hover,
    .filter.active {
      border-color: var(--color-blue-border);
      background: color-mix(in srgb, var(--color-navy) 32%, var(--color-bg-elevated));
      color: var(--color-text);
    }

    .filter:hover { transform: translateY(-1px); }

    .filter.active {
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-blue) 30%, transparent), 0 7px 18px rgba(6, 24, 39, 0.12);
    }

    .filter.active span {
      background: var(--color-blue-deep);
      color: #fff;
    }

    .publication-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .publication-filter-item {
      min-width: 0;
      animation: publication-enter 320ms ease both;
    }

    .publication-filter-item[hidden] { display: none; }

    .filter-empty {
      margin: 2rem 0 0;
      padding: 1.5rem;
      border: 1px dashed var(--color-blue-border);
      border-radius: 16px;
      background: var(--color-navy-surface);
      color: var(--color-text-muted);
      text-align: center;
    }

    @keyframes publication-enter {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 760px) {
      .publications-page {
        padding-right: 1rem;
        padding-left: 1rem;
      }

      .publication-grid { grid-template-columns: 1fr; }

      .index-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.75rem;
      }

      .publication-controls {
        flex-wrap: nowrap;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 0.25rem;
        scrollbar-width: none;
      }

      .publication-controls::-webkit-scrollbar { display: none; }
      .filter { flex: 0 0 auto; }
    }

    @media (max-width: 480px) {
      .publications-page { padding-top: 2.5rem; }
      .lead-publication { margin-bottom: 3rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .publication-filter-item { animation: none; }
      .filter { transition: none; }
      .filter:hover { transform: none; }
    }
  </style>
</BaseLayout>
