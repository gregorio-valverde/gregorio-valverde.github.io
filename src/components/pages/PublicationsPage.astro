---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../SEO.astro';
import { getCollection } from 'astro:content';
import { contentLang, contentSlug, localizePath, localeCode, ui, type Lang } from '../../i18n';
interface Props { lang?: Lang; }
const { lang='es' }=Astro.props;
const copy=ui[lang].publications;
const publications=(await getCollection('publications')).filter(p=>contentLang(p.id)===lang && !p.data.draft).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const formatDate=(d:Date)=>new Intl.DateTimeFormat(localeCode(lang),{month:'short',year:'numeric'}).format(d);
---
<BaseLayout lang={lang}>
<SEO slot="head" title={copy.title} description={copy.description} type="website" />
<main class="page-container publications-page" data-publications-root>
<header class="page-header"><h1 class="page-title">{copy.heading}</h1><p class="page-intro">{copy.intro}</p></header>
<div class="publication-controls" role="group" aria-label={lang==='es'?'Filtrar publicaciones':'Filter publications'}>
<button type="button" class="filter active" data-filter="all">{copy.all}<span>{publications.length}</span></button>
<button type="button" class="filter" data-filter="decision">{copy.decision}<span>{publications.filter(p=>p.data.type==='decision').length}</span></button>
<button type="button" class="filter" data-filter="article">{copy.article}<span>{publications.filter(p=>p.data.type==='article').length}</span></button>
<button type="button" class="filter" data-filter="note">{copy.note}<span>{publications.filter(p=>p.data.type==='note').length}</span></button>
</div>
<div class="publication-grid" aria-live="polite">
{publications.map(pub=><a class="publication-card" data-type={pub.data.type} href={localizePath(`/publications/${contentSlug(pub.id)}`,lang)}>
<div class="card-top"><span class:list={['type-badge',`type-${pub.data.type}`]}>{copy.types[pub.data.type]}</span><time>{formatDate(pub.data.date)}</time></div>
<h2>{pub.data.title}</h2><p>{pub.data.description}</p><div class="tags">{pub.data.tags.slice(0,4).map(t=><span>{t}</span>)}</div><span class="read">{copy.read} →</span>
</a>)}
</div>
<p class="filter-empty" hidden>{copy.empty}</p>
</main>
<script>
function initPublications(){document.querySelectorAll('[data-publications-root]').forEach(root=>{if(root.getAttribute('data-ready')==='true')return;root.setAttribute('data-ready','true');const buttons=[...root.querySelectorAll('.filter')];const cards=[...root.querySelectorAll('.publication-card')];const empty=root.querySelector('.filter-empty');buttons.forEach(btn=>btn.addEventListener('click',()=>{const filter=btn.getAttribute('data-filter');buttons.forEach(b=>b.classList.toggle('active',b===btn));let visible=0;cards.forEach(card=>{const show=filter==='all'||card.getAttribute('data-type')===filter;card.toggleAttribute('hidden',!show);if(show)visible++});if(empty)empty.toggleAttribute('hidden',visible!==0);}));});}document.addEventListener('astro:page-load',initPublications);initPublications();
</script>
<style>
.publication-controls{display:flex;flex-wrap:wrap;gap:.6rem;margin:0 0 2rem}.filter{display:inline-flex;align-items:center;gap:.5rem;border:1px solid var(--color-border);background:var(--color-bg-secondary);color:var(--color-text-secondary);padding:.62rem .9rem;border-radius:999px;cursor:pointer;font:inherit;font-size:.82rem}.filter span{font-size:.68rem;opacity:.65}.filter:hover,.filter.active{color:var(--color-text);border-color:var(--color-text-muted);background:var(--color-bg-elevated)}.filter.active{box-shadow:inset 0 0 0 1px var(--color-accent)}.publication-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.publication-card{display:flex;flex-direction:column;min-height:260px;padding:1.4rem;border:1px solid var(--color-border);border-radius:16px;background:var(--color-bg-secondary);text-decoration:none;transition:transform .2s ease,border-color .2s ease,background .2s ease}.publication-card:hover{transform:translateY(-3px);border-color:var(--color-text-muted);background:var(--color-bg-elevated)}.publication-card[hidden]{display:none}.card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}.card-top time{font-size:.72rem;color:var(--color-text-muted)}.type-badge{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;font-weight:700;padding:.3rem .5rem;border:1px solid var(--color-border);border-radius:6px}.type-decision{color:var(--color-accent);border-color:color-mix(in srgb,var(--color-accent) 45%,var(--color-border))}.type-article{color:#10b981}.type-note{color:#f59e0b}.publication-card h2{font-size:1.15rem;line-height:1.35;margin-bottom:.7rem;color:var(--color-text)}.publication-card p{color:var(--color-text-secondary);font-size:.92rem;line-height:1.6}.tags{display:flex;gap:.4rem;flex-wrap:wrap;margin:1rem 0}.tags span{font-size:.68rem;color:var(--color-text-muted);border:1px solid var(--color-border);border-radius:999px;padding:.25rem .45rem}.read{margin-top:auto;color:var(--color-text);font-size:.8rem;font-weight:650}.filter-empty{color:var(--color-text-muted)}@media(max-width:700px){.publication-grid{grid-template-columns:1fr}}
</style>
</BaseLayout>
