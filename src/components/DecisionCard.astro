---
import BaseCard from './BaseCard.astro';
import ForwardLink from './ForwardLink.astro';
import { localeCode, localizePath, ui, type Lang } from '../i18n';

interface Props {
  title: string;
  slug: string;
  context: string;
  date: Date;
  tags?: string[];
  maxContextLength?: number;
  lang?: Lang;
}

const { title, slug, context, date, tags = [], maxContextLength = 180, lang = 'es' } = Astro.props;
const copy = ui[lang].decisions;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat(localeCode(lang), { year: 'numeric', month: 'long' }).format(date);
}

function truncate(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return text.slice(0, maxLength).trim() + '...';
}

const truncatedContext = truncate(context, maxContextLength);
const href = localizePath(`/decisions/${slug}`, lang);
---

<BaseCard href={href} class="decision-card">
  <Fragment slot="meta">{formatDate(date)}</Fragment>
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{truncatedContext}</Fragment>

  {tags.length > 0 && (
    <div slot="tags" class="tags-list">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  )}

  <ForwardLink text={copy.readDecision} />
</BaseCard>
