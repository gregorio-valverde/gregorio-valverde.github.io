---
import { siteConfig } from '../config';
import { buildMailtoUrl } from '../utils/contact';
import { getLangFromUrl } from '../i18n';
import SiteIcon from './icons/SiteIcon.astro';

const lang = getLangFromUrl(Astro.url);
const currentYear = new Date().getFullYear();
const emailLabel = lang === 'es' ? 'Enviar email' : 'Send email';
const emailSubject = lang === 'es' ? 'Contacto desde tu portfolio' : 'Contact from your portfolio';
const emailUrl = buildMailtoUrl(siteConfig.author.email, emailSubject);

const platformLabels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  twitter: 'X / Twitter',
  mastodon: 'Mastodon',
  bluesky: 'Bluesky',
};

const socialLinks = Object.entries(siteConfig.social)
  .filter(([, url]) => Boolean(url))
  .map(([platform, url]) => ({
    platform: platformLabels[platform] || platform,
    url,
  }));
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-identity">
      <span class="copyright">
        © <span data-current-year>{currentYear}</span> {siteConfig.author.name}
      </span>
      <span class="footer-role">{siteConfig.author.title}</span>
    </div>

    <div class="footer-actions">
      <a
        href={emailUrl}
        class="footer-email"
      >
        <SiteIcon name="mail" size={15} />
        {emailLabel}
      </a>

      {socialLinks.length > 0 && (
        <div class="footer-social" aria-label={lang === 'es' ? 'Redes profesionales' : 'Professional profiles'}>
          {socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.platform}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>

<script>
  function updateCurrentYear() {
    const year = String(new Date().getFullYear());
    document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((element) => {
      element.textContent = year;
    });
  }

  document.addEventListener('astro:page-load', updateCurrentYear);
  updateCurrentYear();
</script>

<style>
  .site-footer {
    margin-top: auto;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
  }

  .footer-container {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .footer-identity {
    display: grid;
    gap: 0.18rem;
  }

  .copyright {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .footer-role {
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    align-items: center;
    justify-content: flex-end;
  }

  .footer-email {
    display: inline-flex;
    gap: 0.42rem;
    align-items: center;
    padding: 0.46rem 0.64rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    font-size: 0.72rem;
    font-weight: 650;
    text-decoration: none;
    transition: color var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
  }

  .footer-email:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-social a {
    color: var(--color-text-muted);
    font-size: 0.74rem;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-social a:hover {
    color: var(--color-text);
  }

  @media (max-width: 680px) {
    .site-footer {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .footer-container,
    .footer-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-actions {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-email,
    .footer-social a {
      transition: none;
    }

    .footer-email:hover {
      transform: none;
    }
  }
</style>
