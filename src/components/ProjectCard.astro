---
import BaseCard from './BaseCard.astro';
import ForwardLink from './ForwardLink.astro';
import ProjectVisual from './ProjectVisual.astro';
import { localizePath, ui, type Lang } from '../i18n';

interface Props {
  title: string;
  slug: string;
  outcomeSummary: string;
  role: string;
  year: number;
  techStack?: string[];
  featured?: boolean;
  status?: 'completed' | 'ongoing' | 'coming-soon' | 'archived';
  lang?: Lang;
}

const {
  title,
  slug,
  outcomeSummary,
  role,
  year,
  techStack = [],
  featured = false,
  status = 'completed',
  lang = 'es',
} = Astro.props;

const copy = ui[lang].projects;
const isComingSoon = status === 'coming-soon';
const displayTech = techStack.slice(0, 4);
const hasMoreTech = techStack.length > 4;
const statusConfig = {
  completed: { label: copy.completed, class: 'status--completed' },
  ongoing: { label: copy.ongoing, class: 'status--ongoing' },
  'coming-soon': { label: lang === 'es' ? 'Próximamente' : 'Coming soon', class: 'status--coming-soon' },
  archived: { label: copy.archived, class: 'status--archived' },
};
const statusInfo = statusConfig[status];
const href = localizePath(`/projects/${slug}`, lang);
---

<BaseCard href={href} class="project-card">
  <ProjectVisual slot="visual" slug={slug} techStack={techStack} />
  <div slot="badge" class="card-badges">
    {featured && (
      <span class="featured-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        {copy.featured}
      </span>
    )}
    {status !== 'completed' && (
      <span class:list={['status-badge', statusInfo.class]}>{statusInfo.label}</span>
    )}
  </div>

  {!isComingSoon && <Fragment slot="meta">{role} · {year}</Fragment>}
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{isComingSoon ? (lang === 'es' ? 'En proceso.' : 'In progress.') : outcomeSummary}</Fragment>

  {!isComingSoon && displayTech.length > 0 && (
    <div slot="tags" class="tags-list">
      {displayTech.map((tech) => <span class="tag">{tech}</span>)}
      {hasMoreTech && <span class="tag-more">+{techStack.length - 4}</span>}
    </div>
  )}

  <ForwardLink text={isComingSoon ? (lang === 'es' ? 'Ver estado' : 'View status') : copy.viewCaseStudy} />
</BaseCard>

<style>
  .card-badges { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .card-badges:empty { display: none; }
  .featured-badge { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent); }
  .featured-badge svg { flex-shrink: 0; }
  .status-badge { display: inline-flex; align-items: center; font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.25rem 0.5rem; border-radius: 4px; }
  .status--ongoing { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
  .status--coming-soon { background: rgba(255, 153, 0, 0.14); color: #ffb13b; }
  .status--archived { background: rgba(115, 115, 115, 0.15); color: var(--color-text-muted); }
  :global(.project-card) { overflow: hidden; transform: translateY(0); transition: transform .22s ease, border-color .22s ease, background .22s ease; }
  :global(.project-card:hover) { transform: translateY(-4px); }
  .tag-more { font-size: 0.75rem; padding: 0.25rem 0.5rem; color: var(--color-text-muted); }
</style>
