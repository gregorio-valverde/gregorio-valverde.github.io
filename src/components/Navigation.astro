---
import { siteConfig } from '../config';
import { buildMailtoUrl } from '../utils/contact';
import SiteIcon from './icons/SiteIcon.astro';
import {
  getLangFromUrl,
  localizePath,
  switchLanguagePath,
  ui,
  type Lang,
} from '../i18n';

interface Props {
  lang?: Lang;
  alternatePath?: string;
}

const currentPath = Astro.url.pathname;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const copy = ui[lang];
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const alternatePath = Astro.props.alternatePath ?? switchLanguagePath(currentPath, otherLang);

const navItems = [
  { key: 'home', href: '/' },
  ...siteConfig.nav,
].map((item) => ({
  label: copy.nav[item.key as keyof typeof copy.nav],
  href: localizePath(item.href, lang),
}));

const isActive = (href: string) => {
  const normalizedCurrent = currentPath.endsWith('/') && currentPath !== '/'
    ? currentPath.slice(0, -1)
    : currentPath;
  const normalizedHref = href.endsWith('/') && href !== '/'
    ? href.slice(0, -1)
    : href;

  if (normalizedHref === '/' || normalizedHref === '/en') {
    return normalizedCurrent === normalizedHref;
  }
  return normalizedCurrent.startsWith(normalizedHref);
};

const enPath = lang === 'en' ? currentPath : alternatePath;
const esPath = lang === 'es' ? currentPath : alternatePath;
const emailSubject = lang === 'es' ? 'Contacto desde tu portfolio' : 'Contact from your portfolio';
const emailUrl = buildMailtoUrl(siteConfig.author.email, emailSubject);

const emailCopy = lang === 'es'
  ? {
      button: 'Email',
      menu: 'Opciones de email',
      copy: 'Copiar',
      copied: 'Copiado',
      send: 'Enviar',
      copyAria: `Copiar ${siteConfig.author.email} al portapapeles`,
      sendAria: `Enviar un email a ${siteConfig.author.email}`,
    }
  : {
      button: 'Email',
      menu: 'Email options',
      copy: 'Copy',
      copied: 'Copied',
      send: 'Send',
      copyAria: `Copy ${siteConfig.author.email} to clipboard`,
      sendAria: `Send an email to ${siteConfig.author.email}`,
    };
---

<nav class="site-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
  <div class="nav-scroll">
    <ul class="nav-list">
      {navItems.map((item) => (
        <li class="nav-item">
          <a
            href={item.href}
            class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="nav-end">
    <div
      class="email-menu"
      data-email-menu
      data-email={siteConfig.author.email}
    >
      <button
        type="button"
        class="email-shortcut"
        data-email-trigger
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label={emailCopy.menu}
        title={emailCopy.menu}
      >
        <SiteIcon name="mail" size={17} />
        <span class="email-shortcut-label">{emailCopy.button}</span>
        <span class="email-chevron" aria-hidden="true">⌄</span>
      </button>

      <div
        class="email-popover"
        data-email-popover
        role="menu"
        aria-label={emailCopy.menu}
        hidden
      >
        <div class="email-popover-address">{siteConfig.author.email}</div>

        <div class="email-popover-actions">
          <button
            type="button"
            class="email-option"
            data-email-copy
            data-default-label={emailCopy.copy}
            data-success-label={emailCopy.copied}
            role="menuitem"
            aria-label={emailCopy.copyAria}
          >
            <span data-email-copy-icon><SiteIcon name="copy" size={16} /></span>
            <span data-email-copy-success-icon hidden><SiteIcon name="check" size={16} /></span>
            <span data-email-copy-label>{emailCopy.copy}</span>
          </button>

          <a
            href={emailUrl}
            class="email-option email-option--send"
            role="menuitem"
            aria-label={emailCopy.sendAria}
          >
            <SiteIcon name="mail" size={16} />
            <span>{emailCopy.send}</span>
          </a>
        </div>
      </div>
    </div>

    <span class="nav-divider" aria-hidden="true"></span>

    <div class="language-switcher" aria-label={lang === 'es' ? 'Cambiar idioma' : 'Change language'}>
      <a href={enPath} class:list={['language-link', { active: lang === 'en' }]} lang="en">EN</a>
      <span class="language-separator">/</span>
      <a href={esPath} class:list={['language-link', { active: lang === 'es' }]} lang="es">ES</a>
    </div>
  </div>
</nav>

<script>
  function updateActiveNav() {
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

    navLinks.forEach((link) => {
      const rawHref = link.getAttribute('href');
      if (!rawHref) return;
      const href = rawHref.replace(/\/$/, '') || '/';
      let active = false;

      if (href === '/' || href === '/en') {
        active = currentPath === href;
      } else {
        active = currentPath.startsWith(href);
      }

      link.classList.toggle('nav-link--active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function fallbackCopy(value: string) {
    const textArea = document.createElement('textarea');
    textArea.value = value;
    textArea.setAttribute('readonly', '');
    textArea.style.position = 'fixed';
    textArea.style.opacity = '0';
    textArea.style.pointerEvents = 'none';
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand('copy');
    textArea.remove();
  }

  function initEmailMenus() {
    document.querySelectorAll<HTMLElement>('[data-email-menu]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const trigger = root.querySelector<HTMLButtonElement>('[data-email-trigger]');
      const popover = root.querySelector<HTMLElement>('[data-email-popover]');
      const copyButton = root.querySelector<HTMLButtonElement>('[data-email-copy]');
      const copyLabel = root.querySelector<HTMLElement>('[data-email-copy-label]');
      const copyIcon = root.querySelector<HTMLElement>('[data-email-copy-icon]');
      const successIcon = root.querySelector<HTMLElement>('[data-email-copy-success-icon]');
      const email = root.dataset.email ?? '';

      if (!trigger || !popover) return;

      let resetTimer: number | undefined;

      const setOpen = (open: boolean) => {
        popover.hidden = !open;
        trigger.setAttribute('aria-expanded', String(open));
        root.classList.toggle('is-open', open);
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const open = trigger.getAttribute('aria-expanded') !== 'true';

        document.querySelectorAll<HTMLElement>('[data-email-menu].is-open').forEach((otherRoot) => {
          if (otherRoot === root) return;
          otherRoot.classList.remove('is-open');
          const otherTrigger = otherRoot.querySelector<HTMLElement>('[data-email-trigger]');
          const otherPopover = otherRoot.querySelector<HTMLElement>('[data-email-popover]');
          otherTrigger?.setAttribute('aria-expanded', 'false');
          if (otherPopover) otherPopover.hidden = true;
        });

        setOpen(open);
      });

      copyButton?.addEventListener('click', async () => {
        if (!email || !copyLabel) return;

        try {
          if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(email);
          else fallbackCopy(email);
        } catch {
          fallbackCopy(email);
        }

        copyLabel.textContent = copyButton.dataset.successLabel ?? 'Copied';
        copyButton.dataset.copied = 'true';
        if (copyIcon) copyIcon.hidden = true;
        if (successIcon) successIcon.hidden = false;

        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          copyLabel.textContent = copyButton.dataset.defaultLabel ?? 'Copy';
          copyButton.dataset.copied = 'false';
          if (copyIcon) copyIcon.hidden = false;
          if (successIcon) successIcon.hidden = true;
        }, 1800);
      });

      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !root.contains(event.target)) setOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || trigger.getAttribute('aria-expanded') !== 'true') return;
        setOpen(false);
        trigger.focus();
      });
    });
  }

  function initNavigation() {
    updateActiveNav();
    initEmailMenus();
  }

  document.addEventListener('astro:page-load', initNavigation);
  initNavigation();
</script>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    min-height: 64px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-blue-border) 54%, var(--color-border));
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-navy) 18%, var(--color-bg)), color-mix(in srgb, var(--color-bg) 94%, transparent));
    box-shadow: 0 8px 28px rgba(4, 15, 25, 0.15);
    backdrop-filter: blur(16px) saturate(125%);
    -webkit-backdrop-filter: blur(16px) saturate(125%);
  }

  .nav-scroll {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav-scroll::-webkit-scrollbar { display: none; }

  .nav-list {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: clamp(1.15rem, 2.8vw, 2rem);
    min-width: max-content;
    margin: 0;
    padding: 0.7rem 1.5rem;
    list-style: none;
  }

  .nav-item {
    flex-shrink: 0;
    margin: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 1px;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-blue-deep), var(--color-blue));
    box-shadow: 0 0 12px var(--color-blue-glow);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-base);
  }

  .nav-link:hover,
  .nav-link--active { color: var(--color-text); }

  .nav-link:hover::after,
  .nav-link--active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-end {
    position: relative;
    z-index: 20;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.65rem;
    min-height: 64px;
    padding: 0 0.9rem 0 1rem;
    border-left: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 94%, var(--color-navy) 6%);
  }

  .nav-end::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -30px;
    width: 30px;
    background: linear-gradient(to right, transparent, var(--color-bg));
    pointer-events: none;
  }

  .email-menu { position: relative; }

  .email-shortcut {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    min-height: 36px;
    padding: 0.48rem 0.68rem;
    border: 1px solid var(--color-blue-border);
    border-radius: 9px;
    color: var(--color-text-secondary);
    background: linear-gradient(145deg, var(--color-navy-surface), var(--color-bg-secondary));
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base), background var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  .email-shortcut:hover,
  .email-menu.is-open .email-shortcut {
    border-color: var(--color-blue);
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-navy) 46%, var(--color-bg-elevated));
    box-shadow: 0 8px 22px rgba(5, 22, 36, 0.20);
    transform: translateY(-1px);
  }

  .email-shortcut-label { line-height: 1; }

  .email-chevron {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 0.8;
    transform: translateY(-1px);
    transition: transform var(--transition-base);
  }

  .email-menu.is-open .email-chevron { transform: rotate(180deg) translateY(1px); }

  .email-popover {
    position: absolute;
    z-index: 100;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(238px, calc(100vw - 1rem));
    padding: 0.65rem;
    border: 1px solid var(--color-blue-border);
    border-radius: 14px;
    background:
      radial-gradient(circle at 100% 0%, var(--color-blue-muted), transparent 45%),
      color-mix(in srgb, var(--color-bg-secondary) 92%, var(--color-navy) 8%);
    box-shadow: 0 18px 38px rgba(2, 12, 21, 0.42);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .email-popover-address {
    overflow: hidden;
    padding: 0.45rem 0.5rem 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .email-popover-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .email-option {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-bg-elevated);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 720;
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .email-option:hover {
    border-color: var(--color-blue-border);
    background: color-mix(in srgb, var(--color-navy) 35%, var(--color-bg-elevated));
    color: var(--color-text);
  }

  .email-option--send {
    border-color: var(--color-blue-border);
    background: var(--gradient-blue);
    color: #fff;
  }

  .email-option--send:hover { color: #fff; }

  .email-option[data-copied='true'] {
    border-color: var(--color-blue);
    color: var(--color-accent-hover);
  }

  .nav-divider {
    width: 1px;
    height: 24px;
    background: var(--color-border);
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.05em;
  }

  .language-link {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .language-link:hover,
  .language-link.active { color: var(--color-text); }

  .language-link.active { text-shadow: 0 0 18px var(--color-blue-glow); }

  .language-separator { color: var(--color-border); }

  @media (max-width: 900px) {
    .nav-list {
      justify-content: flex-start;
      gap: 1.35rem;
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .nav-end {
      padding-right: 0.6rem;
      padding-left: 0.7rem;
    }

    .email-shortcut-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .email-shortcut {
      width: 38px;
      padding: 0;
    }

    .email-chevron { display: none; }
  }

  @media (max-width: 520px) {
    .site-nav,
    .nav-end { min-height: 58px; }

    .nav-link {
      min-height: 32px;
      font-size: 0.7rem;
    }

    .nav-list {
      gap: 1.15rem;
      padding-top: 0.55rem;
      padding-bottom: 0.55rem;
    }

    .nav-divider { display: none; }
    .language-switcher { font-size: 0.66rem; }

    .email-popover {
      position: fixed;
      top: 64px;
      right: 0.5rem;
      width: min(260px, calc(100vw - 1rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after,
    .email-shortcut,
    .email-chevron,
    .email-option { transition: none; }

    .email-shortcut:hover { transform: none; }
  }
</style>
