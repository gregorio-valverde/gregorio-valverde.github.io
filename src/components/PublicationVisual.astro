---
import type { Lang } from '../i18n';

interface Props {
  slug: string;
  lang?: Lang;
  priority?: boolean;
  variant?: 'card' | 'featured' | 'detail';
}

const {
  slug,
  lang = 'es',
  variant = 'card',
} = Astro.props as Props;

const normalizedSlug = slug.toLowerCase();
const isDbtArchitecture = normalizedSlug.includes('dbt-first-data-architecture');
const isDataMaturity = normalizedSlug.includes('data-maturity-technology-culture');
const isCommunication = normalizedSlug.includes('communication-also-part-of-engineering');

const copy = lang === 'es'
  ? {
      dbtKicker: 'Decisión de arquitectura',
      dbtTitle: 'Modelos antes que dashboards',
      dbtFooter: 'Gobernanza · Calidad · Escalabilidad',
      maturityKicker: 'Madurez del dato',
      maturityTitle: 'De herramientas a cultura',
      maturityFooter: 'La tecnología es solo una parte del cambio',
      systems: 'Sistemas',
      platform: 'Plataforma',
      culture: 'Cultura',
      communicationKicker: 'Artículo · Ingeniería',
      communicationTitle: 'La ingeniería también comunica',
      communicationFooter: 'Técnica · Negocio · Personas',
      technical: 'Técnica',
      business: 'Negocio',
      people: 'Personas',
      genericKicker: 'Data Engineering',
      genericTitle: 'Ideas que conectan datos y negocio',
      genericFooter: 'Arquitectura · Analítica · Decisiones',
    }
  : {
      dbtKicker: 'Architecture decision',
      dbtTitle: 'Models before dashboards',
      dbtFooter: 'Governance · Quality · Scalability',
      maturityKicker: 'Data maturity',
      maturityTitle: 'From tools to culture',
      maturityFooter: 'Technology is only one part of the change',
      systems: 'Systems',
      platform: 'Platform',
      culture: 'Culture',
      communicationKicker: 'Article · Engineering',
      communicationTitle: 'Engineering also communicates',
      communicationFooter: 'Technical · Business · People',
      technical: 'Technical',
      business: 'Business',
      people: 'People',
      genericKicker: 'Data Engineering',
      genericTitle: 'Ideas connecting data and business',
      genericFooter: 'Architecture · Analytics · Decisions',
    };
---

<div
  class:list={[
    'publication-visual',
    `publication-visual--${variant}`,
    isDbtArchitecture && 'publication-visual--dbt',
    isDataMaturity && 'publication-visual--maturity',
    isCommunication && 'publication-visual--communication',
    !isDbtArchitecture && !isDataMaturity && !isCommunication && 'publication-visual--generic',
  ]}
  aria-hidden="true"
>
  {isDbtArchitecture ? (
    <div class="cover-scene dbt-scene">
      <div class="cover-copy">
        <span class="cover-kicker"><i></i>{copy.dbtKicker}</span>
        <strong>{copy.dbtTitle}</strong>
        <span class="cover-footer">{copy.dbtFooter}</span>
      </div>

      <div class="lineage-board">
        <div class="board-header">
          <span><i></i> lineage.yml</span>
          <b>dbt</b>
        </div>
        <div class="lineage-flow">
          <span class="lineage-node lineage-node--raw"><b>RAW</b><small>source</small></span>
          <span class="lineage-link lineage-link--one"><i></i></span>
          <span class="lineage-node lineage-node--stg"><b>STG</b><small>clean</small></span>
          <span class="lineage-link lineage-link--two"><i></i></span>
          <span class="lineage-node lineage-node--mart"><b>MART</b><small>model</small></span>
          <span class="lineage-link lineage-link--three"><i></i></span>
          <span class="lineage-node lineage-node--bi"><b>BI</b><small>serve</small></span>
        </div>
        <div class="board-tests">
          <span><i></i> unique</span>
          <span><i></i> not_null</span>
          <span><i></i> relationships</span>
        </div>
      </div>
    </div>
  ) : isDataMaturity ? (
    <div class="cover-scene maturity-scene">
      <div class="cover-copy">
        <span class="cover-kicker"><i></i>{copy.maturityKicker}</span>
        <strong>{copy.maturityTitle}</strong>
        <span class="cover-footer">{copy.maturityFooter}</span>
      </div>

      <div class="maturity-map">
        <span class="maturity-beam"><i></i></span>
        <div class="maturity-stage maturity-stage--one">
          <span>01</span>
          <i class="stage-icon stage-icon--systems"><b></b><b></b><b></b></i>
          <strong>{copy.systems}</strong>
        </div>
        <div class="maturity-stage maturity-stage--two">
          <span>02</span>
          <i class="stage-icon stage-icon--platform"><b></b><b></b><b></b></i>
          <strong>{copy.platform}</strong>
        </div>
        <div class="maturity-stage maturity-stage--three">
          <span>03</span>
          <i class="stage-icon stage-icon--culture"><b></b><b></b><b></b></i>
          <strong>{copy.culture}</strong>
        </div>
      </div>
    </div>
  ) : isCommunication ? (
    <div class="cover-scene communication-scene">
      <div class="cover-copy">
        <span class="cover-kicker"><i></i>{copy.communicationKicker}</span>
        <strong>{copy.communicationTitle}</strong>
        <span class="cover-footer">{copy.communicationFooter}</span>
      </div>

      <div class="communication-map">
        <span class="communication-ring communication-ring--outer"></span>
        <span class="communication-ring communication-ring--inner"></span>
        <span class="message-path message-path--one"><i></i></span>
        <span class="message-path message-path--two"><i></i></span>
        <span class="message-path message-path--three"><i></i></span>

        <span class="communication-core">
          <i></i><i></i><i></i>
          <b>DATA</b>
        </span>
        <span class="communication-node communication-node--technical">{copy.technical}</span>
        <span class="communication-node communication-node--business">{copy.business}</span>
        <span class="communication-node communication-node--people">{copy.people}</span>
      </div>
    </div>
  ) : (
    <div class="cover-scene generic-scene">
      <div class="cover-copy">
        <span class="cover-kicker"><i></i>{copy.genericKicker}</span>
        <strong>{copy.genericTitle}</strong>
        <span class="cover-footer">{copy.genericFooter}</span>
      </div>

      <div class="generic-grid">
        <span class="generic-orbit"></span>
        <span class="generic-cube generic-cube--one"><i></i><i></i><i></i></span>
        <span class="generic-cube generic-cube--two"><i></i><i></i><i></i></span>
        <span class="generic-cube generic-cube--three"><i></i><i></i><i></i></span>
        <span class="generic-packet generic-packet--one"></span>
        <span class="generic-packet generic-packet--two"></span>
      </div>
    </div>
  )}
</div>

<style>
  .publication-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    isolation: isolate;
    background: #071421;
  }

  .publication-visual--detail {
    aspect-ratio: 16 / 8.5;
    min-height: clamp(260px, 48vw, 560px);
    border: 1px solid var(--color-blue-border);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
  }

  .cover-scene {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow: hidden;
    isolation: isolate;
    padding: 1rem;
  }

  .cover-scene::before {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image:
      linear-gradient(rgba(151, 193, 225, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(151, 193, 225, 0.055) 1px, transparent 1px);
    background-size: 32px 32px;
    content: '';
    mask-image: linear-gradient(90deg, transparent, #000 31%, #000);
  }

  .cover-scene::after {
    position: absolute;
    z-index: -1;
    right: -8%;
    bottom: -40%;
    width: 60%;
    height: 75%;
    border-radius: 50%;
    content: '';
    filter: blur(42px);
    opacity: 0.72;
  }

  .dbt-scene {
    background:
      radial-gradient(circle at 85% 20%, rgba(255, 123, 80, 0.24), transparent 28%),
      radial-gradient(circle at 24% 110%, rgba(42, 213, 255, 0.16), transparent 42%),
      linear-gradient(118deg, #07141f 0%, #10263a 53%, #2c1717 100%);
  }

  .dbt-scene::after { background: rgba(255, 119, 76, 0.18); }

  .maturity-scene {
    background:
      radial-gradient(circle at 89% 20%, rgba(96, 227, 179, 0.22), transparent 28%),
      radial-gradient(circle at 35% 112%, rgba(86, 137, 255, 0.2), transparent 43%),
      linear-gradient(118deg, #07141f 0%, #11243d 52%, #122d2a 100%);
  }

  .maturity-scene::after { background: rgba(65, 224, 169, 0.16); }

  .communication-scene {
    background:
      radial-gradient(circle at 86% 24%, rgba(163, 111, 255, 0.26), transparent 28%),
      radial-gradient(circle at 20% 110%, rgba(44, 210, 255, 0.18), transparent 42%),
      linear-gradient(118deg, #07141f 0%, #11243b 49%, #241843 100%);
  }

  .communication-scene::after { background: rgba(141, 91, 255, 0.2); }

  .generic-scene {
    background:
      radial-gradient(circle at 84% 22%, rgba(47, 213, 255, 0.22), transparent 28%),
      radial-gradient(circle at 22% 110%, rgba(127, 104, 255, 0.2), transparent 43%),
      linear-gradient(118deg, #07141f 0%, #10243a 50%, #18183d 100%);
  }

  .generic-scene::after { background: rgba(61, 195, 255, 0.16); }

  .cover-copy {
    position: relative;
    z-index: 4;
    display: flex;
    width: 58%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .cover-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: #a9dbea;
    font-size: clamp(0.48rem, 0.75vw, 0.62rem);
    font-weight: 760;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .cover-kicker i {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: #48dcff;
    box-shadow: 0 0 13px #48dcff;
    animation: coverSignal 2.1s ease-in-out infinite;
  }

  .publication-visual--dbt .cover-kicker i { background: #ff8461; box-shadow: 0 0 13px #ff8461; }
  .publication-visual--maturity .cover-kicker i { background: #55e2ac; box-shadow: 0 0 13px #55e2ac; }
  .publication-visual--communication .cover-kicker i { background: #b082ff; box-shadow: 0 0 13px #b082ff; }

  .cover-copy > strong {
    max-width: 720px;
    margin-top: clamp(0.28rem, 1vw, 0.55rem);
    color: #f4f8fc;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 770;
    letter-spacing: -0.058em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .cover-footer {
    margin-top: 0.58rem;
    color: #aabccb;
    font-size: clamp(0.49rem, 0.72vw, 0.64rem);
    font-weight: 620;
    letter-spacing: 0.035em;
  }

  /* dbt architecture */
  .lineage-board {
    position: relative;
    z-index: 3;
    width: min(43%, 510px);
    min-width: 285px;
    padding: clamp(0.75rem, 2vw, 1.2rem);
    border: 1px solid rgba(182, 213, 233, 0.17);
    border-radius: clamp(14px, 2vw, 22px);
    background: rgba(5, 18, 29, 0.62);
    box-shadow: 0 24px 60px rgba(0, 7, 18, 0.38), inset 0 1px rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(8px);
    transform: perspective(850px) rotateY(-5deg) rotateX(2deg);
    transition: transform 420ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  :global(.publication-card:hover) .lineage-board {
    transform: perspective(850px) rotateY(-2deg) rotateX(0deg) translateY(-3px);
  }

  .board-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(171, 205, 226, 0.11);
    color: #91a9bb;
    font-size: clamp(0.42rem, 0.8vw, 0.62rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .board-header span {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
  }

  .board-header span i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #58dfb2;
    box-shadow: 0 0 8px #58dfb2;
  }

  .board-header b {
    color: #ffad8e;
    font-size: 1.05em;
  }

  .lineage-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    padding: clamp(0.9rem, 2.3vw, 1.65rem) 0;
  }

  .lineage-node {
    display: flex;
    min-width: clamp(44px, 6vw, 67px);
    min-height: clamp(37px, 5vw, 52px);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid rgba(170, 207, 231, 0.2);
    border-radius: clamp(8px, 1.4vw, 13px);
    background: rgba(14, 32, 50, 0.84);
    box-shadow: 0 10px 23px rgba(1, 7, 18, 0.25);
  }

  .lineage-node b {
    color: #eaf5fb;
    font-size: clamp(0.45rem, 0.9vw, 0.68rem);
    letter-spacing: 0.06em;
  }

  .lineage-node small {
    margin-top: 2px;
    color: #8299aa;
    font-size: clamp(0.33rem, 0.6vw, 0.48rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lineage-node--raw { border-color: rgba(83, 211, 255, 0.38); }
  .lineage-node--stg { border-color: rgba(93, 231, 181, 0.38); }
  .lineage-node--mart { border-color: rgba(255, 135, 96, 0.48); }
  .lineage-node--bi { border-color: rgba(183, 123, 255, 0.45); }

  .lineage-link {
    position: relative;
    width: clamp(18px, 3vw, 42px);
    height: 1px;
    overflow: hidden;
    background: linear-gradient(90deg, rgba(76, 204, 255, 0.18), rgba(103, 224, 255, 0.7), rgba(76, 204, 255, 0.18));
  }

  .lineage-link::after {
    position: absolute;
    top: -8px;
    right: -1px;
    color: rgba(145, 220, 249, 0.7);
    content: '›';
  }

  .lineage-link i {
    position: absolute;
    top: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ff8b68;
    box-shadow: 0 0 8px #ff8b68;
    animation: lineagePacket 2.3s linear infinite;
  }

  .lineage-link--two i { animation-delay: -0.8s; background: #59e3b0; box-shadow: 0 0 8px #59e3b0; }
  .lineage-link--three i { animation-delay: -1.55s; background: #b781ff; box-shadow: 0 0 8px #b781ff; }

  .board-tests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(171, 205, 226, 0.11);
  }

  .board-tests span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.22rem 0.4rem;
    border: 1px solid rgba(168, 201, 222, 0.14);
    border-radius: 999px;
    color: #8fa8b9;
    font-size: clamp(0.34rem, 0.6vw, 0.46rem);
    font-weight: 650;
  }

  .board-tests i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #55dfad;
  }

  /* Maturity */
  .maturity-map {
    position: relative;
    z-index: 3;
    display: flex;
    width: min(45%, 520px);
    min-width: 300px;
    height: min(72%, 310px);
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(0.45rem, 1.5vw, 1.2rem);
    padding: 1rem 0.3rem 0.5rem;
  }

  .maturity-beam {
    position: absolute;
    z-index: -1;
    right: 6%;
    bottom: 29%;
    left: 6%;
    height: 2px;
    overflow: hidden;
    background: linear-gradient(90deg, rgba(73, 205, 255, 0.16), rgba(91, 229, 177, 0.72), rgba(169, 118, 255, 0.72));
    transform: rotate(-13deg);
    transform-origin: left center;
  }

  .maturity-beam i {
    position: absolute;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5be3b3;
    box-shadow: 0 0 13px #5be3b3;
    animation: maturityProgress 3.6s ease-in-out infinite;
  }

  .maturity-stage {
    position: relative;
    display: flex;
    width: 31%;
    align-items: center;
    flex-direction: column;
    padding: clamp(0.65rem, 1.8vw, 1.1rem) 0.45rem;
    border: 1px solid rgba(173, 210, 232, 0.18);
    border-radius: clamp(12px, 1.8vw, 19px);
    background: rgba(7, 23, 38, 0.66);
    box-shadow: 0 16px 32px rgba(0, 8, 20, 0.3);
    backdrop-filter: blur(7px);
    transition: transform 260ms ease, border-color 260ms ease;
  }

  .maturity-stage--one { min-height: 47%; }
  .maturity-stage--two { min-height: 67%; border-color: rgba(82, 211, 255, 0.28); }
  .maturity-stage--three { min-height: 88%; border-color: rgba(91, 229, 177, 0.37); }

  :global(.publication-card:hover) .maturity-stage--one { transform: translateY(-2px); }
  :global(.publication-card:hover) .maturity-stage--two { transform: translateY(-5px); }
  :global(.publication-card:hover) .maturity-stage--three { transform: translateY(-8px); }

  .maturity-stage > span {
    align-self: flex-start;
    color: #728b9e;
    font-size: clamp(0.38rem, 0.75vw, 0.55rem);
    font-weight: 760;
    letter-spacing: 0.08em;
  }

  .maturity-stage > strong {
    margin-top: auto;
    color: #dcecf5;
    font-size: clamp(0.45rem, 0.95vw, 0.72rem);
    font-weight: 720;
    text-align: center;
  }

  .stage-icon {
    position: relative;
    display: flex;
    width: clamp(28px, 4vw, 48px);
    height: clamp(28px, 4vw, 48px);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 3px;
    margin: auto 0;
    border: 1px solid rgba(136, 204, 235, 0.24);
    border-radius: 13px;
    background: rgba(36, 131, 171, 0.12);
  }

  .stage-icon b {
    display: block;
    width: 48%;
    height: 4px;
    border: 1px solid rgba(191, 226, 242, 0.62);
    border-radius: 50%;
  }

  .stage-icon--platform { background: rgba(91, 131, 255, 0.13); border-color: rgba(101, 151, 255, 0.36); }
  .stage-icon--culture { background: rgba(80, 221, 169, 0.14); border-color: rgba(86, 226, 172, 0.42); }

  .stage-icon--culture b {
    width: 7px;
    height: 7px;
    border: 0;
    border-radius: 50%;
    background: #60dfb1;
    box-shadow: -10px 7px 0 rgba(105, 216, 255, 0.75), 10px 7px 0 rgba(175, 125, 255, 0.75);
  }

  .stage-icon--culture b:nth-child(2),
  .stage-icon--culture b:nth-child(3) { display: none; }

  /* Communication */
  .communication-map {
    position: relative;
    z-index: 3;
    width: min(43%, 500px);
    min-width: 290px;
    height: min(78%, 330px);
  }

  .communication-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgba(121, 191, 239, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-8deg);
  }

  .communication-ring--outer { width: 90%; height: 68%; }
  .communication-ring--inner { width: 58%; height: 44%; border-color: rgba(177, 121, 255, 0.32); transform: translate(-50%, -50%) rotate(13deg); }

  .communication-core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    width: clamp(64px, 9vw, 104px);
    height: clamp(64px, 9vw, 104px);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid rgba(177, 123, 255, 0.48);
    border-radius: 31%;
    background: linear-gradient(145deg, rgba(71, 209, 255, 0.13), rgba(158, 91, 255, 0.24)), rgba(7, 21, 38, 0.9);
    box-shadow: 0 0 0 8px rgba(154, 97, 255, 0.05), 0 20px 44px rgba(0, 7, 19, 0.4);
    transform: translate(-50%, -50%) rotate(4deg);
  }

  .communication-core i {
    width: 42%;
    height: 4px;
    margin: 2px 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #51d8ff, #b27cff);
  }

  .communication-core b {
    margin-top: 0.3rem;
    color: #e7f4fb;
    font-size: clamp(0.4rem, 0.75vw, 0.58rem);
    letter-spacing: 0.12em;
  }

  .communication-node {
    position: absolute;
    display: grid;
    min-width: clamp(62px, 8vw, 98px);
    min-height: clamp(28px, 4vw, 42px);
    place-items: center;
    padding: 0.4rem;
    border: 1px solid rgba(168, 205, 229, 0.2);
    border-radius: 11px;
    background: rgba(8, 23, 39, 0.78);
    box-shadow: 0 13px 28px rgba(0, 7, 18, 0.3);
    color: #d8eaf4;
    font-size: clamp(0.4rem, 0.8vw, 0.62rem);
    font-weight: 700;
    backdrop-filter: blur(6px);
  }

  .communication-node--technical { top: 7%; left: 2%; border-color: rgba(68, 207, 255, 0.42); }
  .communication-node--business { top: 8%; right: 1%; border-color: rgba(255, 179, 82, 0.42); }
  .communication-node--people { right: 10%; bottom: 2%; border-color: rgba(182, 119, 255, 0.48); }

  .message-path {
    position: absolute;
    z-index: 2;
    height: 1px;
    background: linear-gradient(90deg, rgba(87, 213, 255, 0.12), rgba(139, 131, 255, 0.65), rgba(87, 213, 255, 0.12));
    transform-origin: left center;
  }

  .message-path--one { top: 34%; left: 22%; width: 31%; transform: rotate(19deg); }
  .message-path--two { top: 36%; left: 52%; width: 30%; transform: rotate(-21deg); }
  .message-path--three { top: 62%; left: 54%; width: 28%; transform: rotate(27deg); }

  .message-path i {
    position: absolute;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #51d9ff;
    box-shadow: 0 0 11px #51d9ff;
    animation: messageTravel 2.8s linear infinite;
  }

  .message-path--two i { animation-delay: -0.95s; background: #ffb45d; box-shadow: 0 0 11px #ffb45d; }
  .message-path--three i { animation-delay: -1.8s; background: #b77fff; box-shadow: 0 0 11px #b77fff; }

  /* Generic */
  .generic-grid {
