---
import DecisionDetailPage from '../../components/pages/DecisionDetailPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { contentLang, contentSlug, localizePath } from '../../i18n';

export const getStaticPaths: GetStaticPaths = async () => {
  const decisions = await getCollection('decisions');
  const esDecisions = decisions.filter((decision) => contentLang(decision.id) === 'es');
  const enSlugs = new Set(decisions.filter((decision) => contentLang(decision.id) === 'en').map((decision) => contentSlug(decision.id)));

  return esDecisions.map((decision) => {
    const slug = contentSlug(decision.id);
    return {
      params: { slug },
      props: {
        decision,
        alternatePath: enSlugs.has(slug) ? localizePath(`/decisions/${slug}`, 'en') : localizePath('/decisions', 'en'),
      },
    };
  });
};

interface Props { decision: CollectionEntry<'decisions'>; alternatePath?: string; }
const { decision, alternatePath } = Astro.props as Props;
---
<DecisionDetailPage decision={decision} lang="es" alternatePath={alternatePath} />
