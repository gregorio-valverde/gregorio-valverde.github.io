---
import ProjectDetailPage from '../../components/pages/ProjectDetailPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { contentLang, contentSlug, localizePath } from '../../i18n';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  const esProjects = projects.filter((project) => contentLang(project.id) === 'es');
  const enSlugs = new Set(projects.filter((project) => contentLang(project.id) === 'en').map((project) => contentSlug(project.id)));

  return esProjects.map((project) => {
    const slug = contentSlug(project.id);
    return {
      params: { slug },
      props: {
        project,
        alternatePath: enSlugs.has(slug) ? localizePath(`/projects/${slug}`, 'en') : localizePath('/projects', 'en'),
      },
    };
  });
};

interface Props { project: CollectionEntry<'projects'>; alternatePath?: string; }
const { project, alternatePath } = Astro.props as Props;
---
<ProjectDetailPage project={project} lang="es" alternatePath={alternatePath} />
