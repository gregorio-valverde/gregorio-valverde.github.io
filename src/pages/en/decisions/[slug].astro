---
import DecisionDetailPage from '../../../components/pages/DecisionDetailPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { contentLang, contentSlug, localizePath } from '../../../i18n';

export const getStaticPaths: GetStaticPaths = async () => {
  const decisions = await getCollection('decisions');
  const enDecisions = decisions.filter((decision) => contentLang(decision.id) === 'en');
  const esSlugs = new Set(decisions.filter((decision) => contentLang(decision.id) === 'es').map((decision) => contentSlug(decision.id)));

  return enDecisions.map((decision) => {
    const slug = contentSlug(decision.id);
    return {
      params: { slug },
      props: {
        decision,
        alternatePath: esSlugs.has(slug) ? localizePath(`/decisions/${slug}`, 'es') : localizePath('/decisions', 'es'),
      },
    };
  });
};

interface Props { decision: CollectionEntry<'decisions'>; alternatePath?: string; }
const { decision, alternatePath } = Astro.props as Props;
---
<DecisionDetailPage decision={decision} lang="en" alternatePath={alternatePath} />
